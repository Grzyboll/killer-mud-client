<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:MudClient.App.Views.Panels"
             xmlns:docking="using:MudClient.App.Docking"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:map="using:MudClient.Core.Map"
             xmlns:models="using:MudClient.App.Models"
             xmlns:controls="using:MudClient.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="MudClient.App.Controls.TerminalOverlayCard"
             x:DataType="docking:PanelTool">
  <Border Background="{StaticResource MudBrushVoid}"
          BorderBrush="{StaticResource MudBrushGoldDim}"
          BorderThickness="1"
          CornerRadius="6"
          ClipToBounds="True"
          Margin="4"
          Opacity="{DynamicResource TerminalOverlayOpacityResource}">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="{StaticResource MudBrushSlate}"
              Padding="6,1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" VerticalAlignment="Center"
                     FontFamily="{DynamicResource WidgetFontFamilyResource}"
                     FontSize="{DynamicResource WidgetFontSizeResource}"
                     FontWeight="{DynamicResource WidgetFontWeightResource}"
                     Foreground="{StaticResource MudBrushGoldBright}"
                     Text="{Binding Title}" />

          <!-- Move this overlay: ▲▼ reorder within its own column, ◀▶ move it one column further
               from (◀) or closer to (▶) the right edge — all columns float on the right side of
               the Terminal, which itself never moves or resizes (see TerminalOverlayHost). Wired
               via Click handlers reading this card's own Overlay property (set by
               TerminalOverlayHost alongside DataContext) directly in code-behind — a
               `$parent[TerminalOverlayCard].Overlay.MoveXCommand` binding compiled fine but never
               actually fired the commands at runtime, leaving the buttons looking inert. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,3,0">
            <Button Content="◀" Padding="2,0" FontSize="9" MinWidth="0" MinHeight="0"
                    ToolTip.Tip="Przenieś do kolumny bardziej w lewo"
                    Click="MoveLeft_OnClick" />
            <Button Content="▲" Padding="2,0" FontSize="9" MinWidth="0" MinHeight="0"
                    ToolTip.Tip="Przesuń w górę"
                    Click="MoveUp_OnClick" />
            <Button Content="▼" Padding="2,0" FontSize="9" MinWidth="0" MinHeight="0"
                    ToolTip.Tip="Przesuń w dół"
                    Click="MoveDown_OnClick" />
            <Button Content="▶" Padding="2,0" FontSize="9" MinWidth="0" MinHeight="0"
                    ToolTip.Tip="Przenieś do kolumny bardziej w prawo"
                    Click="MoveRight_OnClick" />
          </StackPanel>

          <Button Grid.Column="2" Content="?" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  IsVisible="{Binding HasHelpTopic}"
                  AutomationProperties.Name="Pomoc dla panelu"
                  ToolTip.Tip="Pomoc dla tego panelu">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <controls:PanelHelpContent DataContext="{Binding HelpTopic}" />
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Generic per-panel settings placeholder (no behavior yet) — hidden for Map, Mem,
               Group, and Chat, which show their real settings menus via the buttons below
               instead. -->
          <Button Grid.Column="3" Content="⚙" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  ToolTip.Tip="Ustawienia panelu (wkrótce)">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                <Binding Path="!IsMapTool" />
                <Binding Path="!IsMemTool" />
                <Binding Path="!IsGroupTool" />
                <Binding Path="!IsChatTool" />
                <Binding Path="!IsOffensiveTool" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>

          <!-- Mem's real settings — buff-set management moved in from the former Buffs tool.
               Shares MainWindowViewModel as Context like Effects above, same special-casing. -->
          <Button Grid.Column="3" Content="⚙" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  IsVisible="{Binding IsMemTool}"
                  AutomationProperties.Name="Ustawienia panelu Mem i Buffy"
                  ToolTip.Tip="Ustawienia zestawów buffów">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer MaxHeight="480">
                <StackPanel Spacing="6" MinWidth="240" MaxWidth="300"
                            TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                            TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                            TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
                  <CheckBox Content="Rozszerzony widok innych efektów"
                            IsChecked="{Binding ((vm:MainWindowViewModel)Context).ShowExtendedEffects}" />
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).BuffSets}" SelectedItem="{Binding ((vm:MainWindowViewModel)Context).SelectedBuffSet, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:BuffSetEntry"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Button Grid.Column="1" Content="＋" ToolTip.Tip="Nowy zestaw" Click="CreateBuffSet_OnClick" />
                    <Button Grid.Column="2" Content="↻" ToolTip.Tip="Aktualizuj zestaw obecnym stanem" Command="{Binding ((vm:MainWindowViewModel)Context).UpdateBuffSetCommand}" />
                    <Button Grid.Column="3" Classes="mud-danger" Content="✕" ToolTip.Tip="Usuń zestaw" IsEnabled="{Binding ((vm:MainWindowViewModel)Context).CanDeleteBuffSet}" Click="DeleteBuffSet_OnClick" />
                  </Grid>
                  <TextBox Text="{Binding ((vm:MainWindowViewModel)Context).NewBuffSetName, Mode=TwoWay}" PlaceholderText="Nazwa nowego zestawu" KeyDown="NewBuffSetBox_OnKeyDown" />
                  <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,2" />

                  <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

                  <TextBlock Classes="mud-heading" Text="Dodaj do aktywnego zestawu" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0"
                             Text="{Binding ((vm:MainWindowViewModel)Context).NewBuffName, Mode=TwoWay}"
                             PlaceholderText="Nazwa buffa (np. armor)"
                             KeyDown="NewBuffBox_OnKeyDown" />
                    <Button Grid.Column="1" Content="Dodaj" Padding="10,6" Click="AddBuff_OnClick" />
                  </Grid>
                </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Group's real settings — the group spell shortcut editor (label -> spell name, e.g.
               "cc" -> "cure critical") shown as a button next to each group member. Duplicated
               from PanelToolView.axaml's GroupSettingsButton for the same reason Effects'/Mem's
               are duplicated above — this card renders outside PanelToolView's own chrome. -->
          <Button Grid.Column="3" Content="⚙" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  IsVisible="{Binding IsGroupTool}"
                  AutomationProperties.Name="Ustawienia panelu Drużyna"
                  ToolTip.Tip="Skróty czarów drużyny">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <!-- Flyout content renders outside this card's own visual tree, so it can't rely
                     on the app's usual "mud-configurable-widget" descendant styling — the shared
                     widget font is applied explicitly here instead. -->
          <StackPanel Spacing="6" MinWidth="260" MaxWidth="320"
                            TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                            TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
              <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).GroupSpellSets}" SelectedItem="{Binding ((vm:MainWindowViewModel)Context).SelectedGroupSpellSet, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:GroupSpellSetEntry"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Button Grid.Column="1" Content="＋" ToolTip.Tip="Nowy zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).CreateGroupSpellSetCommand}" />
              <Button Grid.Column="2" Content="↻" ToolTip.Tip="Aktualizuj zestaw obecnym stanem" Command="{Binding ((vm:MainWindowViewModel)Context).UpdateGroupSpellSetCommand}" />
              <Button Grid.Column="3" Classes="mud-danger" Content="✕" ToolTip.Tip="Usuń zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).DeleteGroupSpellSetCommand}" />
            </Grid>
            <TextBox PlaceholderText="Nazwa nowego zestawu" Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellSetName, Mode=TwoWay}" />
            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,2" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                             Text="Zdefiniuj skrót (np. „cc”) dla nazwy czaru/umiejętności (np. „cure critical”) — obok każdego członka drużyny pojawi się przycisk, który rzuci go na tę konkretną osobę." />
                  <ItemsControl ItemsSource="{Binding ((vm:MainWindowViewModel)Context).GroupSpells}"
                                Tag="{Binding ((vm:MainWindowViewModel)Context)}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:GroupSpellShortcut">
                        <Border Classes="mud-status-chip" Padding="6,3" Margin="0,0,4,4">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="→" />
                            <TextBlock Text="{Binding SpellName}" Opacity="0.75" />
                            <Button Classes="mud-small mud-danger"
                                    Content="✕"
                                    Padding="4,0"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)Tag).RemoveGroupSpellCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="60,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBox Grid.Row="0" Grid.Column="0"
                             PlaceholderText="cc"
                             Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellLabel, Mode=TwoWay}" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             PlaceholderText="cure critical"
                             Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellName, Mode=TwoWay}" />
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="+ Dodaj"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ((vm:MainWindowViewModel)Context).AddGroupSpellCommand}" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- OffensiveActions' real settings — the offensive-action and custom-command shortcut
               editors, matching the panel's two sections. Duplicated from PanelToolView.axaml's
               OffensiveSettingsButton for the same reason Effects'/Mem's/Group's are duplicated
               above. -->
          <Button Grid.Column="3" Content="⚙" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  IsVisible="{Binding IsOffensiveTool}"
                  AutomationProperties.Name="Ustawienia panelu Offensywne i Definiowalne"
                  ToolTip.Tip="Skróty akcji offensywnych i komend">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ScrollViewer MaxHeight="480">
          <StackPanel Spacing="6" MinWidth="260" MaxWidth="320"
                            TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                            TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
              <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).ActionSets}" SelectedItem="{Binding ((vm:MainWindowViewModel)Context).SelectedActionSet, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:ActionSetEntry"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Button Grid.Column="1" Content="＋" ToolTip.Tip="Nowy zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).CreateActionSetCommand}" />
              <Button Grid.Column="2" Content="↻" ToolTip.Tip="Aktualizuj zestaw obecnym stanem" Command="{Binding ((vm:MainWindowViewModel)Context).UpdateActionSetCommand}" />
              <Button Grid.Column="3" Classes="mud-danger" Content="✕" ToolTip.Tip="Usuń zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).DeleteActionSetCommand}" />
            </Grid>
            <TextBox PlaceholderText="Nazwa nowego zestawu" Text="{Binding ((vm:MainWindowViewModel)Context).NewActionSetName, Mode=TwoWay}" />
            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,2" />
            <ToggleSwitch Content="Sekcje jedna przy drugiej"
                                IsChecked="{Binding ((vm:MainWindowViewModel)Context).OffensiveSectionsSideBySide, Mode=TwoWay}"
                                ToolTip.Tip="Offensywne po lewej, Definiowalne po prawej — lepiej widoczne na szerokim oknie." />

                  <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

                  <TextBlock Classes="mud-heading" Text="Offensywne" />
                  <ItemsControl ItemsSource="{Binding ((vm:MainWindowViewModel)Context).OffensiveActions}"
                                Tag="{Binding ((vm:MainWindowViewModel)Context)}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:OffensiveActionShortcut">
                        <Border Classes="mud-status-chip" Padding="6,3" Margin="0,0,4,4">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="→" />
                            <TextBlock Text="{Binding SpellName}" Opacity="0.75" />
                            <Button Classes="mud-small mud-danger"
                                    Content="✕"
                                    Padding="4,0"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)Tag).RemoveOffensiveActionCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBox Grid.Row="0"
                             PlaceholderText="Nazwa spella/skilla (pełna)"
                             Text="{Binding ((vm:MainWindowViewModel)Context).NewOffensiveActionSpellName, Mode=TwoWay}" />
                    <TextBox Grid.Row="1"
                             PlaceholderText="Skrót"
                             Text="{Binding ((vm:MainWindowViewModel)Context).NewOffensiveActionLabel, Mode=TwoWay}" />
                    <Button Grid.Row="2"
                            Content="Dodaj"
                            HorizontalAlignment="Stretch"
                            Padding="10,6"
                            Command="{Binding ((vm:MainWindowViewModel)Context).AddOffensiveActionCommand}" />
                  </Grid>
                  <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                             Text="Liczba przycisków w rzędzie:" Margin="0,4,0,0" />
                  <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).OffensiveColumnsOptions}"
                            SelectedItem="{Binding ((vm:MainWindowViewModel)Context).OffensiveActionColumnsCount, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                  <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

                  <TextBlock Classes="mud-heading" Text="Definiowalne" />
                  <ItemsControl ItemsSource="{Binding ((vm:MainWindowViewModel)Context).CustomCommands}"
                                Tag="{Binding ((vm:MainWindowViewModel)Context)}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:CustomCommandShortcut">
                        <Border Classes="mud-status-chip" Padding="6,3" Margin="0,0,4,4">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="→" />
                            <TextBlock Text="{Binding Command}" Opacity="0.75" />
                            <Button Classes="mud-small mud-danger"
                                    Content="✕"
                                    Padding="4,0"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)Tag).RemoveCustomCommandCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBox Grid.Row="0"
                             PlaceholderText="Podaj pełną komendę"
                             Text="{Binding ((vm:MainWindowViewModel)Context).NewCustomCommandCommand, Mode=TwoWay}" />
                    <TextBox Grid.Row="1"
                             PlaceholderText="Skrót"
                             Text="{Binding ((vm:MainWindowViewModel)Context).NewCustomCommandLabel, Mode=TwoWay}" />
                    <Button Grid.Row="2"
                            Content="Dodaj"
                            HorizontalAlignment="Stretch"
                            Padding="10,6"
                            Command="{Binding ((vm:MainWindowViewModel)Context).AddCustomCommandCommand}" />
                  </Grid>
                  <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                             Text="Liczba przycisków w rzędzie:" Margin="0,4,0,0" />
                  <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).OffensiveColumnsOptions}"
                            SelectedItem="{Binding ((vm:MainWindowViewModel)Context).CustomCommandColumnsCount, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Chat's real settings — sound-on-new-message toggle. Duplicated from
               PanelToolView.axaml's ChatSettingsButton for the same reason Effects'/Mem's/Group's
               are duplicated above. -->
          <Button Grid.Column="3" Content="⚙" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  IsVisible="{Binding IsChatTool}"
                  ToolTip.Tip="Ustawienia czatu">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="6" MinWidth="230" MaxWidth="280"
                            TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                            TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                            TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
                  <CheckBox Content="Dźwięk przy nowej wiadomości"
                            IsChecked="{Binding ((vm:MainWindowViewModel)Context).ChatSoundOnNewMessageEnabled}" />
                  <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                             Text="Krótki dźwięk systemowy przy każdej nowej linii komunikacji (say/tell/clantell/grouptell/yell/shout)." />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="2" Content="⚙" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0" IsVisible="{Binding IsStatisticsTool}"
                  ToolTip.Tip="Ustawienia statystyk">
            <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="6" MinWidth="230"
                          TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                          TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                          TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
                <Button Content="Resetuj statystyki postaci" Classes="mud-danger"
                        HorizontalAlignment="Stretch" Click="ResetStatistics_OnClick"/>
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Usuwa całą zapisaną historię aktywnej postaci."/>
              </StackPanel>
            </Flyout></Button.Flyout>
          </Button>

          <!-- Map's real settings menu, duplicated from MapPanelView's own (hidden there while
               shown as an overlay card — see MapPanelView.axaml.cs) so it can live in the title
               bar next to the close button instead of floating over the map content. -->
          <Button Grid.Column="3" Content="⚙" Padding="3,0" Margin="0,0,3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  IsVisible="{Binding IsMapTool}"
                  AutomationProperties.Name="Ustawienia mapy"
                  ToolTip.Tip="Ustawienia mapy">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ContentControl Content="{Binding Context}">
                  <ContentControl.DataTemplates>
                    <DataTemplate x:DataType="vm:MapViewModel">
                      <!-- Flyout content renders outside this card's own visual tree, so it can't
                           rely on the app's usual "mud-configurable-widget" descendant styling
                           (see Docking.axaml) — the shared widget font is applied explicitly
                           here instead. Scrollable + height-capped: this flyout also carries
                           everything moved in from the former Autowalk panel. -->
                      <ScrollViewer MaxHeight="640">
                      <StackPanel Spacing="6" MinWidth="230" MaxWidth="300"
                                  TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                                  TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                                  TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
                        <TextBlock Classes="mud-heading" Text="Obszar" />
                        <ComboBox ItemsSource="{Binding Areas}"
                                  SelectedItem="{Binding SelectedArea}"
                                  HorizontalAlignment="Stretch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="map:MapArea">
                              <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="mud-heading" Text="Poziom" Margin="0,4,0,0" />
                        <ComboBox ItemsSource="{Binding ZLevels}"
                                  SelectedIndex="{Binding SelectedZIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Classes="mud-heading" Text="Tryb mapy" Margin="0,4,0,0" />
                        <ComboBox ItemsSource="{Binding DisplayModes}"
                                  SelectedItem="{Binding SelectedDisplayMode}"
                                  HorizontalAlignment="Stretch" />
                        <Border Height="1"
                                Background="{StaticResource MudBrushSlate}"
                                Margin="0,4" />
                        <Button Content="Wycentruj i śledź"
                                Command="{Binding CenterCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="10,6" />
                        <ToggleSwitch Content="Autowalk po dwukliku"
                                      IsChecked="{Binding AutoWalkOnMapDoubleClick}"
                                      ToolTip.Tip="Włączone: dwuklik na pokoju od razu rozpoczyna marsz. Wyłączone: dwuklik tylko podpowiada trasę, do potwierdzenia przyciskiem IDŹ DO CELU." />
                        <ToggleSwitch Content="Członkowie grupy jako cyfry"
                                      IsChecked="{Binding ShowGroupMembersAsNumbers}"
                                      ToolTip.Tip="Numery odpowiadają kolejności członków w drużynie." />
                        <ToggleSwitch Content="Tryb lorda"
                                      IsChecked="{Binding LordModeEnabled}"
                                      ToolTip.Tip="Udostępnia polecenie walk w menu prawego przycisku mapy." />
                        <Border Height="1"
                                Background="{StaticResource MudBrushSlate}"
                                Margin="0,4" />
                        <TextBlock Classes="mud-heading" Text="Automatyka po wejściu do pokoju" />
                        <ToggleSwitch Content="Autoscan"
                                      IsChecked="{Binding AutoScanOnRoomEnter}"
                                      ToolTip.Tip="Po każdym wejściu do nowego pokoju (GMCP) klient wysyła „scan”." />
                        <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                                   Text="Autokill przeniesiony do Automaty → Farma." />
                        <Border Height="1"
                                Background="{StaticResource MudBrushSlate}"
                                Margin="0,4" />
                        <TextBlock Classes="mud-heading" Text="Obszary farmy" />
                        <TextBlock Classes="mud-faint" TextWrapping="Wrap" Text="{Binding AutoFarmRegionStatusText}" />
                        <ToggleSwitch Content="Zaznacz obszar (prawy przycisk + przeciągnięcie)"
                                      IsChecked="{Binding IsDefiningAutoFarmRegion}"
                                      ToolTip.Tip="Po włączeniu przeciągnij prawym przyciskiem myszy po mapie, aby dodać kolejny prostokątny obszar, po którym farma może się poruszać — można dodać ich kilka, także na różnych obszarach/poziomach mapy." />
                        <Button Content="Wyczyść obszary"
                                Classes="mud-small"
                                Command="{Binding ClearAutoFarmRegionCommand}" />
                        <StackPanel Spacing="6" IsVisible="{Binding LordModeEnabled}">
                          <Border Height="1"
                                  Background="{StaticResource MudBrushSlate}"
                                  Margin="0,4" />
                          <TextBlock Classes="mud-heading" Text="Edytor mapy" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewMapAreaName, Mode=TwoWay}"
                                     PlaceholderText="Nazwa nowego obszaru"
                                     ToolTip.Tip="Nowy obszar można utworzyć, gdy mapowanie jest zatrzymane." />
                            <Button Grid.Column="1"
                                    Content="Utwórz obszar"
                                    Command="{Binding CreateMapAreaCommand}"
                                    Padding="10,6" />
                          </Grid>
                          <ToggleSwitch Content="Przenoś istniejące pokoje do wybranego obszaru"
                                        IsChecked="{Binding MoveExistingRoomsToNewArea, Mode=TwoWay}"
                                        IsEnabled="{Binding CanMoveExistingRoomsToNewArea}"
                                        ToolTip.Tip="Zmienia przypisanie napotkanych vnumów na aktualnie wybrany obszar. Pokój, z którego rozpoczęto mapowanie, pozostaje w dotychczasowym obszarze; zmiany można cofnąć." />
                          <WrapPanel>
                            <Button Content="Rozpocznij mapowanie"
                                    Command="{Binding StartMapEditorCommand}"
                                    IsVisible="{Binding !IsMapEditorActive}"
                                    Margin="0,0,6,4"
                                    Padding="10,6" />
                            <Button Content="Zatrzymaj mapowanie"
                                    Command="{Binding StopMapEditorCommand}"
                                    IsVisible="{Binding IsMapEditorActive}"
                                    Margin="0,0,6,4"
                                    Padding="10,6" />
                          </WrapPanel>
                          <WrapPanel>
                            <Button Content="Zapisz"
                                    Command="{Binding SaveMapEditorCommand}"
                                    Margin="0,0,6,4"
                                    Padding="10,6" />
                            <Button Content="Cofnij"
                                    Command="{Binding UndoMapEditorCommand}"
                                    Margin="0,0,6,4"
                                    Padding="10,6" />
                            <Button Content="Ponów"
                                    Command="{Binding RedoMapEditorCommand}"
                                    Margin="0,0,6,4"
                                    Padding="10,6" />
                          </WrapPanel>
                          <TextBlock Classes="mud-faint"
                                     Text="{Binding MapEditorStatus}"
                                     MaxWidth="300"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="mud-faint"
                                     Text="{Binding MapEditorSourceDescription}"
                                     MaxWidth="300"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="mud-faint"
                                    Text="Komendy: /map start|stop|save|undo|redo|cancel|info|check|diff|import|export|discard|resolve|step|area|reassign|room|symbol|label|forget|special (cancel anuluje wszystkie niezapisane zmiany; również /mapa i +map)."
                                     MaxWidth="300"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- ==============================================================
                             Everything below was moved here from the former Autowalk panel —
                             the state and commands still live on MainViewModel
                             (MainWindowViewModel).
                             ============================================================== -->
                        <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="mud-heading" Text="Miejsca śmierci" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Classes="mud-badge">
                            <TextBlock Text="{Binding MainViewModel.Deaths.Count}" />
                          </Border>
                        </Grid>
                        <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                                   Text="Brak zapisanych zgonów. Ostatnie 10 miejsc śmierci pojawi się tutaj automatycznie."
                                   IsVisible="{Binding !MainViewModel.Deaths.Count}" />
                        <ItemsControl ItemsSource="{Binding MainViewModel.Deaths}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DeathMarkEntry">
                              <Border Classes="mud-section" Padding="10,8" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                  <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding When}" Classes="mud-faint"
                                               TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <Button Grid.Column="1"
                                          Classes="mud-small"
                                          Content="⚑ IDŹ" Padding="8,2"
                                          ToolTip.Tip="Idź do miejsca śmierci"
                                          Click="GoToDeath_OnClick" />
                                  <Button Grid.Column="2"
                                          Classes="mud-small mud-danger"
                                          Content="✕" Padding="6,2"
                                          ToolTip.Tip="Usuń wpis"
                                          Click="DeleteDeath_OnClick" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />
                        <TextBlock Classes="mud-heading" Text="Status podróży" />
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Classes="mud-muted" Text="Pozycja:" />
                          <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                     Text="{Binding CurrentRoomName}"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Text="{Binding MainViewModel.AutowalkStatusText}"
                                   Classes="mud-faint" TextWrapping="Wrap" />
                        <Button Content="■ STOP"
                                Classes="mud-danger"
                                Command="{Binding MainViewModel.StopAutowalkCommand}"
                                IsVisible="{Binding MainViewModel.IsAutowalking}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="16,6" />
                        <Button Content="⚑ IDŹ"
                                Command="{Binding MainViewModel.GoToSelectedTargetCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="16,6"
                                ToolTip.Tip="Idź do celu wybranego na mapie (tak samo jak komenda /walk)" />
                        <StackPanel Spacing="6" IsVisible="{Binding MainViewModel.HasTemporaryTarget}">
                          <TextBlock Text="{Binding MainViewModel.TemporaryTargetDisplay}"
                                     TextWrapping="Wrap"
                                     Foreground="{StaticResource MudBrushGoldBright}" />
                          <Button Content="⚑ IDŹ DO CELU"
                                  Command="{Binding MainViewModel.GoToTemporaryTargetCommand}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center" Padding="16,6" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="mud-heading" Text="Lokacje" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Classes="mud-badge">
                            <TextBlock Text="{Binding MainViewModel.Locations.Count}" />
                          </Border>
                        </Grid>
                        <Expander Classes="mud-expander" Header="＋ Nowa lokacja" IsExpanded="False">
                          <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBox Text="{Binding MainViewModel.NewLocationName}"
                                     PlaceholderText="Nazwa lokacji, np. plac-arras…" />
                            <Button Content="⚑ Dodaj obecną pozycję"
                                    Command="{Binding MainViewModel.AddCurrentLocationCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Padding="16,6"
                                    ToolTip.Tip="Zapisuje pokój, w którym teraz stoisz" />
                            <StackPanel Spacing="2">
                              <TextBlock Classes="mud-faint"
                                         Text="…albo podaj numer pomieszczenia (vnum) innej lokacji:" />
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Text="{Binding MainViewModel.NewLocationVnum}"
                                         PlaceholderText="np. 12477" />
                                <Button Grid.Column="1" Content="Dodaj"
                                        Command="{Binding MainViewModel.AddLocationCommand}" Padding="16,6" />
                              </Grid>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding MainViewModel.NewLocationIsGlobal}"
                                      Content="Globalna — wspólna dla wszystkich kont" />
                            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                                       Text="Do członka grupy lub zapisanej lokacji dojdziesz komendą /walk &lt;nazwa&gt;, a do lidera grupy komendą /walk leader. Przycisk IDŹ prowadzi do wybranej lokacji, a /stop przerywa marsz." />
                          </StackPanel>
                        </Expander>
                        <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                                   Text="Brak zapisanych lokacji. Dodaj obecną pozycję albo wpisz vnum docelowego pokoju."
                                   IsVisible="{Binding !MainViewModel.Locations.Count}" />
                        <Button Classes="mud-small" Content="📁 Nowy folder" Padding="10,4"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Utwórz folder na lokacje"
                                Command="{Binding MainViewModel.CreateFolderCommand}"
                                CommandParameter="{x:Static models:FolderKind.Autowalk}" />
                        <controls:FolderTreeView Nodes="{Binding MainViewModel.AutowalkTree}"
                                                 SupportsEnableToggle="False"
                                                 MoveIntoFolderCommand="{Binding MainViewModel.MoveIntoFolderCommand}"
                                                 CreateSubfolderCommand="{Binding MainViewModel.CreateSubfolderCommand}"
                                                 RenameFolderCommand="{Binding MainViewModel.RenameFolderCommand}"
                                                 DeleteFolderCommand="{Binding MainViewModel.DeleteFolderCommand}"
                                                 ToggleFolderGlobalCommand="{Binding MainViewModel.ToggleFolderGlobalCommand}">
                          <controls:FolderTreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:AutowalkLocation">
                              <Border Classes="mud-section" Padding="10,8" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                  <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <TextBlock Text="{Binding Name}"
                                                 TextTrimming="CharacterEllipsis" />
                                      <Border Classes="mud-badge" IsVisible="{Binding IsGlobal}"
                                              ToolTip.Tip="Wspólna dla wszystkich kont">
                                        <TextBlock Text="Globalna" />
                                      </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Display}" Classes="mud-faint"
                                               TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <Button Grid.Column="1"
                                          Classes="mud-small"
                                          Content="⚑ IDŹ" Padding="8,2"
                                          ToolTip.Tip="Idź do tej lokacji"
                                          Click="GoToLocation_OnClick" />
                                  <Button Grid.Column="2"
                                          Classes="mud-small mud-danger"
                                          Content="✕" Padding="6,2"
                                          ToolTip.Tip="Usuń lokację"
                                          Click="DeleteLocation_OnClick" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </controls:FolderTreeView.ItemTemplate>
                        </controls:FolderTreeView>

                      </StackPanel>
                      </ScrollViewer>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="4" Content="✕" Padding="3,0" FontSize="10"
                  MinWidth="0" MinHeight="0"
                  Command="{Binding CloseOverlayCommand}"
                  ToolTip.Tip="Zamknij (panel zostanie ukryty, Terminal pozostaje na wierzchu)" />
        </Grid>
      </Border>
      <panels:PanelToolView Grid.Row="1" DataContext="{Binding}" />
    </Grid>
  </Border>
</UserControl>
