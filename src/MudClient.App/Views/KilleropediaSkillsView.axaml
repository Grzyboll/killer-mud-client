<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:controls="using:MudClient.App.Controls"
             xmlns:models="using:MudClient.App.Models"
             xmlns:conv="using:MudClient.App.Converters"
             x:Class="MudClient.App.Views.KilleropediaSkillsView"
             x:DataType="vm:KilleropediaViewModel"
             Classes="killeropedia-page"
             x:Name="Root">
  <Grid RowDefinitions="Auto,*" RowSpacing="6">
    <Grid Grid.Row="0" ColumnDefinitions="*,200,Auto,Auto,Auto,Auto" ColumnSpacing="10">
      <TextBox Grid.Column="0"
               Text="{Binding AbilitySearchText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Szukaj po nazwie, opisie, nauczycielu..." />
      <Button Grid.Column="1"
              Content="{Binding SelectedAbilityClassesSummaryText}"
              HorizontalContentAlignment="Left"
              HorizontalAlignment="Stretch"
              ToolTip.Tip="Wybierz jedną lub więcej klas, żeby połączyć ich umiejętności w jednym drzewie">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <Border Background="#1B140B" BorderBrush="#71552B" BorderThickness="1" CornerRadius="4" Padding="10">
              <ItemsControl ItemsSource="{Binding AbilityClassOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:AbilityClassOption">
                    <CheckBox Content="{Binding Name}"
                              Foreground="#D8C79D"
                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Command="{Binding #Root.((vm:KilleropediaViewModel)DataContext).ToggleAbilityClassCommand}"
                              CommandParameter="{Binding Name}"
                              Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBlock Grid.Column="2"
                 Classes="mud-faint"
                 Text="{Binding FilteredAbilityCountText}"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{Binding AbilitiesGeneratedText}" />
      <Button Grid.Column="3"
              Content="Sprawdź co zyskasz"
              Padding="14,6"
              ToolTip.Tip="Umiejętności, czary i tatuaże, które dodatkowo zyskasz, wybierając przeglądaną specjalizację">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft" Closed="OnNewAbilitiesFlyoutClosed">
            <Border Background="#1B140B" BorderBrush="#71552B" BorderThickness="1" CornerRadius="4"
                    Padding="12" MaxWidth="360">
              <StackPanel Spacing="6">
                <TextBlock Text="Nowe umiejętności i czary" FontWeight="Bold" Foreground="#E6C14A" />
                <TextBlock Classes="mud-muted"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasNewAbilities}"
                           Text="Wybierz jedną lub więcej specjalizacji w filtrze klas powyżej, żeby zobaczyć, co dodatkowo zyskasz." />
                <ItemsControl ItemsSource="{Binding NewAbilities}" IsVisible="{Binding HasNewAbilities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AbilitySkillTreeEntry">
                      <Border Padding="4,3"
                              ToolTip.Tip="{Binding Converter={x:Static conv:AbilityTooltipConverter.Instance}}"
                              ToolTip.ShowDelay="0"
                              PointerEntered="OnNewAbilityRowPointerEntered"
                              PointerExited="OnNewAbilityRowPointerExited">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" Foreground="#F0E6CE" />
                          <TextBlock Text="{Binding LevelSummaryText}" Foreground="#B8AE98" FontSize="11"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding HasNewTattoos}" BorderBrush="#3A2E18" BorderThickness="0,1,0,0"
                        Margin="0,4,0,0" Padding="0,6,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Tatuaże" FontWeight="Bold" Foreground="#E6C14A" />
                    <ItemsControl ItemsSource="{Binding NewTattoos}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TattooBonusEntry">
                          <Border Padding="4,3"
                                  ToolTip.Tip="{Binding Converter={x:Static conv:TattooTooltipConverter.Instance}}"
                                  ToolTip.ShowDelay="0">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Name}" Foreground="#F0E6CE" />
                              <TextBlock Text="{Binding Description}" Foreground="#B8AE98" FontSize="11"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button Grid.Column="4"
              Content="Resetuj widok"
              Click="OnResetViewClick"
              Padding="14,6"
              ToolTip.Tip="Cofnij przybliżenie/przesunięcie drzewa" />
      <Button Grid.Column="5"
              Content="Odśwież"
              Command="{Binding ReloadAbilitiesCommand}"
              Padding="14,6"
              ToolTip.Tip="Wczytaj ponownie ability-help.json po użyciu /mapuj w grze" />
    </Grid>

    <Border Grid.Row="1"
            Classes="mud-section"
            Padding="18"
            IsVisible="{Binding HasNoAbilities}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Classes="mud-heading-lg" Text="Brak zmapowanych umiejętności" HorizontalAlignment="Center" />
        <TextBlock Classes="mud-muted"
                   Text="Użyj „/mapuj &lt;klasa&gt;” w grze, aby przechwycić tekst pomocy skilli i czarów, a potem kliknij „Odśwież”."
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            CornerRadius="6"
            ClipToBounds="True"
            IsVisible="{Binding HasAbilities}">
      <Border.Background>
        <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.85" RadiusY="0.85">
          <GradientStop Offset="0" Color="#1B2036" />
          <GradientStop Offset="0.55" Color="#12162A" />
          <GradientStop Offset="1" Color="#08090F" />
        </RadialGradientBrush>
      </Border.Background>
      <controls:AbilitySkillTreeCanvas x:Name="TreeCanvas"
                                        ToolTip.Tip="Najedź kursorem na węzeł, żeby zobaczyć szczegóły — kliknij, żeby przypiąć."
                                        ToolTip.ShowDelay="0" />
    </Border>
  </Grid>
</UserControl>
