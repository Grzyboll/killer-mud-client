<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:b="using:MudClient.App.Behaviors"
             xmlns:conv="using:MudClient.App.Converters"
             x:Class="MudClient.App.Views.KilleropediaTeachersView"
             x:DataType="vm:KilleropediaViewModel"
             Classes="killeropedia-page"
             x:Name="Root">
  <TabControl Classes="mud-subtabs">
    <TabItem Header="Wg nauczyciela">
      <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,8,0,0">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBox Grid.Column="0"
               Text="{Binding TeacherSearchText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Szukaj po nauczycielu, umiejętności, triku, klasie, krainie lub vnum..." />
      <TextBlock Grid.Column="1"
                 Classes="mud-faint"
                 Text="{Binding FilteredTeacherCountText}"
                 VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1*,3,2*">
      <Border Grid.Column="0" Classes="mud-inset killeropedia-left-page" Padding="12">
        <ListBox ItemsSource="{Binding FilteredTeachers}"
                 SelectedItem="{Binding SelectedTeacher}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:TeacherEntry">
              <Border Padding="10,8" Margin="0,2" MinHeight="44" CornerRadius="3">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="3">
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             b:SearchHighlight.Text="{Binding Name}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             LineHeight="18" />
                  <TextBlock Grid.Row="0" Grid.Column="1"
                             Classes="mud-faint"
                             Text="{Binding MobVnum, StringFormat='mob {0}'}" />
                  <TextBlock Grid.Row="1" Grid.Column="0"
                             Classes="mud-faint"
                             b:SearchHighlight.Text="{Binding LocationText}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}"
                             TextTrimming="CharacterEllipsis"
                             LineHeight="15" />
                  <TextBlock Grid.Row="1" Grid.Column="1"
                             Classes="mud-faint"
                             Text="{Binding OfferingCountText}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Border Grid.Column="2" Classes="mud-section killeropedia-right-page" Padding="22">
        <ScrollViewer Classes="killeropedia-content-scroll"
                      b:SearchAutoScroll.Terms="{Binding TeacherSearchText}"
                      b:SearchAutoScroll.Context="{Binding SelectedTeacher}">
          <StackPanel Spacing="12" DataContext="{Binding SelectedTeacher}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Classes="mud-heading-lg"
                           b:SearchHighlight.Text="{Binding Name}"
                           b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}" />
                <TextBlock Classes="mud-muted"
                           b:SearchHighlight.Text="{Binding RegionText}"
                           b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7" HorizontalAlignment="Right">
                <TextBlock Classes="mud-faint" Text="{Binding MobVnum, StringFormat='Mob vnum: {0}'}" />
                <TextBlock Classes="mud-faint" Text="{Binding RoomText, StringFormat='Pokój vnum: {0}'}" />
                <Button Content="Pokaż na mapie"
                        HorizontalAlignment="Right"
                        IsVisible="{Binding HasRoomLocation}"
                        Command="{Binding $parent[UserControl].DataContext.ShowTeacherOnMapCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Grid>

            <Border Classes="mud-inset" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Classes="mud-heading" Text="KLASY" />
                <TextBlock b:SearchHighlight.Text="{Binding ClassesText}"
                           b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TabControl x:Name="TeacherOfferingTabs" Classes="mud-subtabs">
              <TabItem Header="Umiejętności">
                <StackPanel Spacing="6" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="2*,80,70,80" ColumnSpacing="8" Margin="8,0">
                    <TextBlock Grid.Column="0" Classes="mud-faint" Text="Nazwa" />
                    <TextBlock Grid.Column="1" Classes="mud-faint" Text="Zakres" />
                    <TextBlock Grid.Column="2" Classes="mud-faint" Text="Cena" />
                    <TextBlock Grid.Column="3" Classes="mud-faint" Text="Wymaga" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding #Root.((vm:KilleropediaViewModel)DataContext).SelectedTeacherSkillOfferings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:TeacherSkillOffering">
                        <Border Classes="mud-inset" Padding="8,6" Margin="0,1">
                          <Grid ColumnDefinitions="2*,80,70,80" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Skill.Name}"
                                       TextDecorations="{Binding State, Converter={x:Static conv:SkillKnowledgeStateStrikethroughConverter.Instance}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Skill.RangeText}" />
                            <TextBlock Grid.Column="2" Text="{Binding Skill.PriceText}" />
                            <TextBlock Grid.Column="3" Text="{Binding Skill.RequirementText}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </TabItem>

              <TabItem Header="Triki">
                <StackPanel Spacing="6" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="*,120,100" ColumnSpacing="8" Margin="8,0">
                    <TextBlock Grid.Column="0" Classes="mud-faint" Text="Nazwa" />
                    <TextBlock Grid.Column="1" Classes="mud-faint" Text="Szansa nauki" />
                    <TextBlock Grid.Column="2" Classes="mud-faint" Text="Cena" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding #Root.((vm:KilleropediaViewModel)DataContext).SelectedTeacherTrickOfferings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:TeacherTrickOffering">
                        <Border Classes="mud-inset" Padding="8,6" Margin="0,1">
                          <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,120,100" ColumnSpacing="8">
                              <TextBlock Grid.Column="0" Text="{Binding Trick.Name}" />
                              <TextBlock Grid.Column="1" Text="{Binding Trick.LearnChanceText}" />
                              <TextBlock Grid.Column="2" Text="{Binding Trick.PriceText}" />
                            </Grid>
                            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                                       b:SearchHighlight.Text="{Binding Trick.DescriptionText}"
                                       b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="Umiejętności">
      <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,8,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <TextBox Grid.Column="0"
                   Text="{Binding TeacherSearchText, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Szukaj po nauczycielu, umiejętności, klasie, krainie lub vnum..." />
          <ToggleButton Grid.Column="1"
                        Classes="mud-small"
                        Content="Tylko możliwe do nauczenia"
                        IsChecked="{Binding ShowOnlyLearnableTeacherOfferings}"
                        ToolTip.Tip="Ukryj umiejętności już opanowane lub niedostępne dla klasy postaci — niedostępne dla klasy są przekreślone" />
          <TextBlock Grid.Column="2"
                     Classes="mud-faint"
                     Text="{Binding FilteredTeacherSkillRowCountText}"
                     VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Classes="mud-inset" Padding="12">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,1.5*,80,70,80" ColumnSpacing="8" Margin="8,0,8,4">
              <TextBlock Grid.Column="0" Classes="mud-faint" Text="Nauczyciel" />
              <TextBlock Grid.Column="1" Classes="mud-faint" Text="Umiejętność" />
              <TextBlock Grid.Column="2" Classes="mud-faint" Text="Zakres" />
              <TextBlock Grid.Column="3" Classes="mud-faint" Text="Cena" />
              <TextBlock Grid.Column="4" Classes="mud-faint" Text="Wymaga" />
            </Grid>
            <ListBox ItemsSource="{Binding FilteredTeacherSkillRows}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:TeacherSkillRow">
                  <Grid ColumnDefinitions="2*,1.5*,80,70,80" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock b:SearchHighlight.Text="{Binding Teacher.Name}"
                                 b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="mud-faint"
                                 Text="{Binding Teacher.LocationText}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Skill.Name}"
                               TextDecorations="{Binding State, Converter={x:Static conv:SkillKnowledgeStateStrikethroughConverter.Instance}}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Skill.RangeText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Skill.PriceText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Skill.RequirementText}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </TabItem>

    <TabItem Header="Triki">
      <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,8,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <TextBox Grid.Column="0"
                   Text="{Binding TeacherSearchText, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Szukaj po nauczycielu, triku, klasie, krainie lub vnum..." />
          <ToggleButton Grid.Column="1"
                        Classes="mud-small"
                        Content="Tylko możliwe do nauczenia"
                        IsChecked="{Binding ShowOnlyLearnableTeacherOfferings}"
                        ToolTip.Tip="Ukryj triki, których wymagania nie są jeszcze spełnione" />
          <TextBlock Grid.Column="2"
                     Classes="mud-faint"
                     Text="{Binding FilteredTeacherTrickRowCountText}"
                     VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Classes="mud-inset" Padding="12">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,1.5*,120,100" ColumnSpacing="8" Margin="8,0,8,4">
              <TextBlock Grid.Column="0" Classes="mud-faint" Text="Nauczyciel" />
              <TextBlock Grid.Column="1" Classes="mud-faint" Text="Trik" />
              <TextBlock Grid.Column="2" Classes="mud-faint" Text="Szansa nauki" />
              <TextBlock Grid.Column="3" Classes="mud-faint" Text="Cena" />
            </Grid>
            <ListBox ItemsSource="{Binding FilteredTeacherTrickRows}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:TeacherTrickRow">
                  <Grid ColumnDefinitions="2*,1.5*,120,100" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock b:SearchHighlight.Text="{Binding Teacher.Name}"
                                 b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).TeacherSearchText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="mud-faint"
                                 Text="{Binding Teacher.LocationText}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Trick.Name}"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Trick.DescriptionText}" />
                    <TextBlock Grid.Column="2" Text="{Binding Trick.LearnChanceText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Trick.PriceText}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
