<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MudClient.App.Controls"
        xmlns:views="using:MudClient.App.Views"
        xmlns:vm="using:MudClient.App.ViewModels"
        xmlns:models="using:MudClient.App.Models"
        xmlns:docking="using:MudClient.App.Docking"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="MudClient.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Icon="/Assets/killer.ico"
        Title="KillerMudClient"
         Width="1400"
         Height="900"
         MinWidth="800"
         MinHeight="680"
         WindowState="Maximized"
        PointerPressed="Window_OnPointerPressed">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Session/account actions — used to live in a branded top bar with an overflow "Więcej"
         menu; now a single left-aligned row of directly visible buttons, with no separate bar
         of its own reserved above the docked panels (see MainDock below). -->
    <Border x:Name="TopActionsBar" Grid.Row="0" Classes="mud-bar-top">
      <Grid ColumnDefinitions="*,Auto">
      <StackPanel x:Name="TopActionsRow"
                  Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="7"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
        <Button x:Name="TopKilleropediaButton"
                Content="Killeropedia"
                Command="{Binding OpenKilleropediaCommand}"
                Classes="mud-small"
                ToolTip.Tip="Otwórz Killeropedię" />
        <TextBlock x:Name="IdleTimeIndicator"
                   Text="{Binding IdleTimeText}"
                   Classes="mud-caption"
                   MinWidth="86"
                   VerticalAlignment="Center"
                   ToolTip.Tip="Czas od ostatniej komendy wysłanej do MUD-a" />
        <TextBlock Text="{Binding StatusText}"
                   Classes="mud-connection-status"
                   VerticalAlignment="Center"
                   MaxWidth="160"
                   TextTrimming="CharacterEllipsis" />
        <Button Content="Połącz"
                Command="{Binding ConnectCommand}"
                IsVisible="{Binding !IsConnected}"
                Classes="mud-small" />
        <Button Classes="mud-danger mud-small"
                Content="Rozłącz"
                Command="{Binding DisconnectCommand}"
                IsVisible="{Binding IsConnected}" />
        <Button Content="Zmień konto"
                Command="{Binding SwitchProfileCommand}"
                Classes="mud-small"
                ToolTip.Tip="Przełączanie konta jest możliwe po rozłączeniu sesji." />
        <Button Content="Discord"
                Command="{Binding OpenDiscordCommand}"
                Classes="mud-small" />
        <Button Content="Pomoc"
                Command="{Binding OpenHelpCommand}"
                Classes="mud-small" />
        <Button Content="Dyskusja"
                Command="{Binding OpenDiscussionsCommand}"
                Classes="mud-small"
                ToolTip.Tip="Otwórz dyskusje projektu na GitHubie" />
        <!-- Only visible once AppUpdateService finds a newer release (see AppUpdateStatus in
             Ustawienia → Aplikacja) — same download page as that panel's own button, just
             reachable without navigating there first. -->
        <Button Content="⬆ Aktualizuj"
                Command="{Binding OpenAppUpdateCommand}"
                IsVisible="{Binding IsAppUpdateAvailable}"
                Classes="mud-small"
                ToolTip.Tip="{Binding AppUpdateStatus}" />
        <Button Content="{Binding HiddenPanels.Count, StringFormat='Przywróć panele ({0})'}"
                IsVisible="{Binding HiddenPanels.Count}"
                Classes="mud-small">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <ItemsControl ItemsSource="{Binding HiddenPanels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="docking:PanelTool">
                    <Button Content="{Binding Title}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Classes="mud-menu-action"
                            Command="{Binding $parent[Window].DataContext.RestorePanelCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Content="Układy paneli" Classes="mud-small">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="6" MinWidth="220">
                <TextBlock Classes="mud-section-title" Text="Wczytaj układ" />
                <ItemsControl ItemsSource="{Binding AvailableLayouts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LayoutMenuItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <Button Grid.Column="0"
                                Content="{Binding Name}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Classes="mud-menu-action"
                                Command="{Binding $parent[Window].DataContext.ApplyLayoutCommand}"
                                CommandParameter="{Binding Name}" />
                        <Button Grid.Column="1"
                                Classes="mud-danger mud-small"
                                Content="✕"
                                Margin="4,0,0,0"
                                ToolTip.Tip="Usuń układ"
                                IsVisible="{Binding CanDelete}"
                                Command="{Binding $parent[Window].DataContext.DeleteLayoutCommand}"
                                CommandParameter="{Binding Name}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="0,3" />
                <TextBlock Classes="mud-section-title" Text="Zapisz obecny układ" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0"
                           Text="{Binding NewLayoutName}"
                           PlaceholderText="Nazwa układu" />
                  <Button Grid.Column="1"
                          Content="Zapisz"
                          Classes="mud-small"
                          Command="{Binding SaveLayoutCommand}" />
                </Grid>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!-- Author's mushroom logo, tucked discreetly in the top-right corner — click opens the
           author's page; the hover tip is a wink, not documentation, so it's left as prose. -->
      <Button x:Name="AuthorLogoButton"
              Grid.Column="1"
              Classes="mud-menu-action"
              Command="{Binding OpenAuthorPageCommand}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="0,0,10,0"
              Padding="4"
              ToolTip.Tip="Podoba ci się to co robię? &quot;Toss A Coin To Your Witcher&quot; - jak mnie spotkasz na trakcie ;)">
        <Image Source="avares://MudClient.App/Assets/mushroom-logo.png"
               Width="22" Height="22"
               Stretch="Uniform" />
      </Button>
      </Grid>
    </Border>

     <!-- ========================================================================
         Row 1: Main content – 25* (left), 50* (terminal), 25* (right)
         ======================================================================== -->
    <dock:DockControl x:Name="MainDock" Grid.Row="1" Layout="{Binding Layout}" Margin="8" />

    <!-- Transient messages float above the workspace instead of increasing header height. -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,18,0"
                Spacing="5"
                Panel.ZIndex="100">
      <ItemsControl ItemsSource="{Binding Toasts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:ToastMessage">
            <Border Classes="mud-toast"
                    IsVisible="{Binding IsVisible}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="{Binding IconGlyph}"
                           Foreground="{Binding ForegroundBrush}" />
                <TextBlock Text="{Binding Text}"
                           MaxWidth="300"
                           ToolTip.Tip="{Binding Text}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="mud-small"
              Content="Wyczyść"
              Command="{Binding ClearToastsCommand}"
              HorizontalAlignment="Right"
              IsVisible="{Binding Toasts.Count}" />
    </StackPanel>

    <controls:LargeTabbedWidget Grid.RowSpan="3"
                                Title="Killeropedia"
                                IsBookStyle="True"
                                IsFullSize="True"
                                IsOpen="{Binding IsKilleropediaOpen}">
      <controls:LargeTabbedWidget.TabContent>
        <TabControl Classes="mud-large-widget-tabs killeropedia-book-tabs">
          <TabItem Classes="killeropedia-tab-teachers" Header="Nauczyciele">
            <views:KilleropediaTeachersView
                                            DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-books" Header="Księgi Magiczne">
            <views:KilleropediaBooksView
                                         DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-book-naming" Header="Losowe Księgi">
            <views:KilleropediaBookNamingView
                                              DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-lore" Header="Świat i lore">
            <views:KilleropediaLoreView
                                        DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-quests" Header="Zadania">
            <views:KilleropediaQuestsView
                                        DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-tattoos" Header="Tatuaże">
            <views:KilleropediaTattoosView
                                          DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-artifacts" Header="Artefakty">
            <views:KilleropediaArtifactsView
                                            DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-skills" Header="Wędrowiec">
            <views:KilleropediaSkillsView
                                          DataContext="{Binding Killeropedia}" />
          </TabItem>
          <TabItem Classes="killeropedia-tab-map" Header="Mapa Świata">
            <views:KilleropediaWorldMapView
                                            DataContext="{Binding Killeropedia}" />
          </TabItem>
        </TabControl>
      </controls:LargeTabbedWidget.TabContent>
    </controls:LargeTabbedWidget>

    <controls:LargeTabbedWidget Grid.RowSpan="3"
                                Title="Pomoc"
                                IsOpen="{Binding IsHelpOpen}">
      <controls:LargeTabbedWidget.TabContent>
        <TabControl Classes="mud-large-widget-tabs">
          <TabItem Header="Dostępne komendy">
            <ScrollViewer Margin="0,12,0,0">
              <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Classes="mud-muted"
                           Text="Komendy klienta wpisuj w polu komendy terminala. Wielkość liter nie ma znaczenia."
                           TextWrapping="Wrap" />

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/walk" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozpoczyna marsz do celu wybranego dwuklikiem na mapie albo wznawia przerwaną podróż." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/walk &lt;cel&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozpoczyna marsz do członka grupy widocznego przez GMCP albo do zapisanej lokacji o podanej nazwie." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/walk leader" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozpoczyna marsz do lidera obecnej grupy widocznego przez GMCP." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="180,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/walk_dodaj &lt;nazwa&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Zapisuje obecną lokację pod podaną nazwą dla aktywnego konta." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/stop" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wyłącznik awaryjny: zatrzymuje autowalk/farmę, wyłącza wszystkie aliasy, triggery i timery, oraz wyłącza wszystkie funkcje automatyzacji (autostand, autoscan itd.). Zapamiętuje co wyłączył, aby /start mogło to przywrócić." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/start" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Przywraca dokładnie to, co wyłączyło ostatnie /stop na tym koncie. Jeśli nic nie jest zapamiętane (np. /stop jeszcze nie było użyte na tym koncie, albo dopiero co zmieniłeś konto), nic się nie dzieje — to zamierzone, żeby /start nigdy nie włączał czegoś, czego to konto nie prosiło o przywrócenie." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/recast" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Ponownie rzuca wszystkie brakujące czary z aktywnego zestawu buffów na postać." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="150,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/reconnect" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Rozłącza i ponownie łączy z bieżącym profilem (razem z automatycznym logowaniem). Działa też z paska komend oraz z timerów, triggerów i aliasów przez send(&quot;/reconnect&quot;)." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/mapuj &lt;klasa&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wysyła 'help &lt;nazwa&gt;' dla każdej umiejętności/czaru zapisanego dla podanej klasy i zapisuje przechwycony tekst do Killeropedii (Umiejętności/Wędrowiec). Nie mylić z /map — ta komenda nie edytuje mapy świata." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/mapuj &lt;liczba&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wysyła kolejno 'try 1', 'try 2', ... aż do 'try &lt;liczba&gt;' (identyfikacja artefaktów) i zapisuje przechwycony tekst do pliku artifact-try.json. Przykład: /mapuj 127." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/map &lt;komenda&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="W trybie lorda steruje edytorem mapy. Pełna lista komend mapowania znajduje się poniżej. Można też używać prefiksów /mapa i +map." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="/map show &lt;vnum&gt;" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="Wyszukuje pokój o podanym VNUM-ie, ustawia go jako cel mapy i otwiera widok mapy. Użyj tej komendy, aby szybko przejść do konkretnego pokoju." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="Komendy mapowania" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="start / stop — rozpoczęcie i zakończenie mapowania; save — zapis zmian; undo / redo — cofanie i ponawianie; cancel — odrzucenie bieżącej sesji; status lub info — stan i informacje o pokoju; check / diff — kontrola i porównanie map; import / export — wymiana mapy z plikiem; discard — odrzucenie mapy roboczej; resolve keep|gmcp — rozwiązanie konfliktu; step &lt;1-20&gt; — krok mapowania; area / reassign — praca z krainą; room — informacje o pokoju; symbol — symbol pokoju; label — etykieta; forget — usunięcie pokoju; special — przejście specjalne." />
                  </Grid>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                    <TextBlock Grid.Column="0" Text="alias(...) w triggerze/timerze" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap"
                               Text="W komendzie triggera albo timera wpisz alias(nazwa-aliasu) lub alias(tekst-dopasowany-do-wzorca). Klient uruchomi istniejący alias i wyśle jego rozwinięcie, także wiele komend rozdzielonych nowymi liniami lub separatorem. Przykład: alias(buff)." />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Automatyzacje">
            <ScrollViewer Margin="0,12,0,0">
              <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Classes="mud-muted"
                           TextWrapping="Wrap"
                           Text="Każdy z poniższych przełączników jest też dostępny jako pole wyboru w panelach automatyzacji — z terminala wpisz samą komendę, aby przełączyć, albo dodaj 'start'/'stop' (albo 'on'/'off', 'wlacz'/'wylacz'), aby ustawić wprost — ten sam start/stop, co globalne /start i /stop, tylko dla jednej funkcji zamiast wszystkiego naraz. Przykład: /autostand start." />

                <ItemsControl ItemsSource="{Binding CommandToggles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CommandToggleEntry">
                      <Border Classes="mud-section" Padding="14">
                        <Grid ColumnDefinitions="220,*" ColumnSpacing="18">
                          <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Command, StringFormat='/{0}'}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MudBrushGoldBright}" />
                            <TextBlock Text="{Binding DisplayName}" Classes="mud-faint" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Skrypty Lua">
            <ScrollViewer Margin="0,12,0,0">
              <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Classes="mud-muted"
                           TextWrapping="Wrap"
                           Text="Każdy alias, trigger i timer można zamienić w skrypt Lua — zaznacz „To skrypt Lua” w edytorze reguły (checkbox pojawia się obok pola Akcja/Komendy). Wzorzec (regex) nadal decyduje KIEDY reguła się odpala; skrypt Lua decyduje CO się wtedy stanie. Wszystkie skrypty jednego konta dzielą jedno wspólne środowisko Lua — zwykłe zmienne globalne (np. count = (count or 0) + 1) zachowują wartość między kolejnymi odpaleniami, dokładnie jak w Mudlecie. Środowisko resetuje się przy przełączeniu na inne konto, więc stan jednej postaci nigdy nie wycieka do drugiej." />

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="send(&quot;komenda&quot;)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" FontFamily="Consolas" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Wysyła komendę do MUD-a. Można wywołać wielokrotnie w jednym skrypcie — komendy pójdą w kolejności wywołań. Brak wywołania send() to normalny, cichy wynik (reguła po prostu nic nie robi)." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="echo(&quot;tekst&quot;)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" FontFamily="Consolas" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Wypisuje tekst w terminalu (tak jak echo wysłanej komendy) — do debugowania albo własnych komunikatów, bez wysyłania niczego do serwera." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="line, match, matches[1], matches[2]…" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" FontFamily="Consolas" />
                    <TextBlock TextWrapping="Wrap"
                               Text="line — cała linia z MUD-a (trigger) albo wpisana komenda (alias), bez zmian. match — fragment dopasowany przez cały wzorzec. matches[1], matches[2]… — grupy przechwytujące ze wzorca (regex), odpowiadające dawnym $1, $2 z szablonów tekstowych. Timer nie ma wzorca, więc te trzy są tam puste/nil." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="hp, maxhp, mv, maxmv, charname, position, roomvnum, roomname" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" FontFamily="Consolas" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Bieżący stan postaci, odświeżany tuż przed każdym uruchomieniem skryptu. Wartości liczbowe (hp, maxhp, mv, maxmv) mogą być nil, dopóki serwer nie przyśle GMCP — zawsze sprawdzaj przed porównaniem, np. „if hp and hp &lt; 50 then”." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Przykład — alias" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap" FontFamily="Consolas"
                               Text="Wzorzec: ^kk (.+)$&#x0a;Akcja (Lua): send(&quot;kill &quot; .. matches[1])" />
                    <TextBlock TextWrapping="Wrap" Classes="mud-faint"
                               Text="Wpisanie „kk orc” wyśle „kill orc”." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Przykład — trigger z licznikiem" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap" FontFamily="Consolas"
                               Text="Wzorzec: ^Zabijasz (.+)\.$&#x0a;Akcja (Lua): kills = (kills or 0) + 1&#x0a;echo(&quot;Zabójstwo #&quot; .. kills .. &quot;: &quot; .. matches[1])" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Przykład — timer korzystający ze stanu postaci" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap" FontFamily="Consolas"
                               Text="Komendy (Lua): if hp and maxhp and hp &lt; maxhp then&#x0a;  send(&quot;odpoczywaj&quot;)&#x0a;end" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Biblioteka Lua (zakładka obok Timerów/Aliasów/Triggerów)" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Miejsce na funkcje pomocnicze współdzielone przez wszystkie skrypty na koncie — zamiast wklejać tę samą logikę do kilku triggerów, zdefiniuj ją raz w bibliotece (np. „function isBoss(name) ... end”) i wywołuj z dowolnego aliasu/triggera/timera. Wczytuje się raz przy aktywacji konta, przed pierwszym odpaleniem jakiegokolwiek skryptu; przycisk „Zapisz i wczytaj” stosuje zmiany od razu, bez przełączania konta." />
                  </StackPanel>
                </Border>

                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Błąd w skrypcie (literówka, dzielenie przez nil itp.) pokazuje się jako czerwony toast z nazwą reguły — ta jedna reguła nic wtedy nie zrobi, ale reszta aliasów/triggerów/timerów działa dalej normalnie." />

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="▶ Testuj" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="W edytorze aliasu/triggera/timera oznaczonego jako skrypt Lua pojawia się przycisk „Testuj” — wpisujesz przykładową komendę (alias) albo linię z MUD-a (trigger) i widzisz, jakie komendy skrypt by wysłał, bez faktycznego odpalania. Uruchamia prawdziwy silnik Lua (ze wspólną biblioteką i zmiennymi), więc jeśli skrypt zmienia licznik globalny, ta zmiana zostaje na stałe — tak jakby naprawdę się odpalił." />
                  </StackPanel>
                </Border>

                <Border Classes="mud-section" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="☰ Kompaktowo" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Przełącznik w Timery/Aliasy/Triggery — ukrywa zawsze widoczny podgląd wzorca/akcji na liście, zostawiając samą nazwę, przełącznik i odznaki. Pełny podgląd nadal dostępny jako podpowiedź po najechaniu na nazwę." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </controls:LargeTabbedWidget.TabContent>
    </controls:LargeTabbedWidget>

    <!-- Profile picker overlay (shown until a profile is chosen) -->
    <Grid Grid.RowSpan="3"
          IsVisible="{Binding !IsProfileSelected}"
          Background="#B0080A0B">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="520"
              Classes="mud-panel"
              BorderBrush="{StaticResource MudBrushGoldBright}"
              BorderThickness="1"
              Padding="24">
        <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Text="⚔" FontSize="28" Foreground="{StaticResource MudBrushGoldBright}" />
            <StackPanel Grid.Column="1">
              <TextBlock Classes="mud-heading-lg" Text="Wybierz konto" />
              <TextBlock Classes="mud-muted"
                         TextWrapping="Wrap"
                         Text="Konto przechowuje hasło, notatki, aliasy, triggery i timery postaci." />
            </StackPanel>
          </Grid>

          <TextBlock Classes="mud-faint"
                     TextWrapping="Wrap"
                     Text="Dwuklik na koncie łączy od razu."
                     IsVisible="{Binding HasProfiles}" />

          <ListBox x:Name="ProfileListBox"
                   ItemsSource="{Binding AvailableProfiles}"
                   SelectedItem="{Binding SelectedProfileName}"
                   MaxHeight="120"
                   Background="Transparent"
                   IsVisible="{Binding HasProfiles}"
                   DoubleTapped="ProfileList_OnDoubleTapped">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="CornerRadius" Value="6" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0"
                             Text="🛡"
                             FontSize="16"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MudBrushGoldBright}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding}"
                             FontSize="14"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="2"
                          Content="🗑"
                          FontSize="12"
                          Padding="6,2"
                          VerticalAlignment="Center"
                          Click="DeleteProfile_OnClick"
                          ToolTip.Tip="Usuń konto (bezpowrotnie kasuje plik konta)" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="mud-faint"
                     TextWrapping="Wrap"
                     Text="Brak zapisanych kont — utwórz pierwsze poniżej."
                     IsVisible="{Binding !HasProfiles}" />

          <StackPanel x:Name="ProfileServerFields"
                      Spacing="6"
                      IsVisible="{Binding HasProfiles}">
            <TextBlock Text="Ustawienia wybranego konta"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MudBrushParchmentDim}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding SelectedProfileLogin}"
                       PlaceholderText="Login MUD"
                       KeyDown="SelectProfileField_OnKeyDown" />
              <TextBox Grid.Column="1"
                       Text="{Binding SelectedProfilePassword}"
                       PasswordChar="●"
                       PlaceholderText="Nowe hasło (opcjonalnie)"
                       KeyDown="SelectProfileField_OnKeyDown"
                       ToolTip.Tip="Puste pole zachowuje zapisane hasło. Hasło jest szyfrowane na dysku." />
            </Grid>
            <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding Host}"
                       PlaceholderText="host"
                       KeyDown="SelectProfileField_OnKeyDown"
                       ToolTip.Tip="Adres serwera MUD dla wybranego konta" />
              <TextBox Grid.Column="1"
                       Text="{Binding Port}"
                       PlaceholderText="port"
                       KeyDown="SelectProfileField_OnKeyDown"
                       ToolTip.Tip="Port serwera dla wybranego konta (1–65535)" />
            </Grid>
            <ComboBox ItemsSource="{Binding AvailableEncodings}"
                      SelectedItem="{Binding Encoding}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="Kodowanie tekstu dla wybranego konta (Auto wykrywa UTF-8 lub Windows-1250 automatycznie)" />
          </StackPanel>

          <Button Content="Wybierz konto"
                  Command="{Binding SelectProfileCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="16,7"
                  IsVisible="{Binding HasProfiles}" />

          <Separator />

          <TextBlock Classes="mud-faint"
                     TextWrapping="Wrap"
                     Text="Nowe konto — jego lokalna nazwa może być inna niż login wysyłany do MUD-a." />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewProfileName}"
                     PlaceholderText="Nazwa konta w aplikacji"
                     KeyDown="CreateProfileField_OnKeyDown" />
            <TextBox Grid.Column="1"
                     Text="{Binding NewProfileLogin}"
                     PlaceholderText="Login MUD"
                     KeyDown="CreateProfileField_OnKeyDown"
                     ToolTip.Tip="Puste pole użyje nazwy konta jako loginu." />
          </Grid>

          <Grid x:Name="NewProfileServerFields" ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewProfileHost}"
                     PlaceholderText="host"
                     KeyDown="CreateProfileField_OnKeyDown"
                     ToolTip.Tip="Adres serwera MUD dla nowego konta" />
            <TextBox Grid.Column="1"
                     Text="{Binding NewProfilePort}"
                     PlaceholderText="port"
                     KeyDown="CreateProfileField_OnKeyDown"
                     ToolTip.Tip="Port serwera dla nowego konta (1–65535)" />
          </Grid>

          <ComboBox ItemsSource="{Binding AvailableEncodings}"
                    SelectedItem="{Binding NewProfileEncoding}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="Kodowanie tekstu dla nowego konta (Auto wykrywa UTF-8 lub Windows-1250 automatycznie)" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding NewProfilePassword}"
                     PasswordChar="●"
                     PlaceholderText="Hasło (zapisywane zaszyfrowane)"
                     KeyDown="CreateProfileField_OnKeyDown" />
            <Button Grid.Column="1"
                    Content="Utwórz"
                    Command="{Binding CreateProfileCommand}"
                    Padding="16,7" />
          </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Startup / fatal error overlay -->
    <Grid Grid.RowSpan="3"
          IsVisible="{Binding HasStartupError}"
          Background="#B0080A0B">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="620"
              MaxWidth="900"
              Classes="mud-panel"
              BorderBrush="{StaticResource MudBrushCrimson}"
              BorderThickness="1"
              Padding="24">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="☠" FontSize="28" Foreground="{StaticResource MudBrushCrimsonBright}" />
            <StackPanel>
              <TextBlock Classes="mud-heading-lg" Text="Błąd uruchamiania" />
              <TextBlock Classes="mud-muted"
                         Text="Aplikacja napotkała problem przy inicjalizacji widoku." />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding StartupErrorMessage}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />

          <Border Classes="mud-section" Background="{StaticResource MudBrushVoid}" Padding="12">
            <TextBlock Text="{Binding StartupErrorDetails}"
                       Classes="mud-faint"
                       TextWrapping="Wrap" />
          </Border>

          <TextBlock Classes="mud-faint"
                     Text="Możesz spróbować ponownie albo zamknąć aplikację i uruchomić ją jeszcze raz." />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Ponów" Command="{Binding RetryStartupCommand}" Padding="16,7" />
            <Button Content="Zamknij" Classes="mud-danger" Click="Close_OnClick" Padding="16,7" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
