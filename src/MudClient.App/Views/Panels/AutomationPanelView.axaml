<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:controls="using:MudClient.App.Controls"
             x:Name="AutomationRoot"
             x:Class="MudClient.App.Views.Panels.AutomationPanelView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <!-- Leaf template for a timer inside the folder tree. -->
    <DataTemplate x:Key="TimerItemTemplate" x:DataType="models:TimerEntry">
      <Border Classes="mud-section" Padding="10,8" Margin="0,2">
        <StackPanel Spacing="6">

          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding CommandsText}" />
              <Border Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding IntervalText, StringFormat='co {0}'}" />
              </Border>
              <Border Classes="mud-badge" IsVisible="{Binding IsGlobal}"
                      ToolTip.Tip="Wspólny dla wszystkich kont">
                <TextBlock Text="Globalny" />
              </Border>
              <Border Classes="mud-badge" IsVisible="{Binding IsScript}"
                      ToolTip.Tip="Skrypt Lua uruchamiany co interwał">
                <TextBlock Text="Lua" />
              </Border>
              <Border Classes="mud-badge" IsVisible="{Binding PlaySoundOnTick}"
                      ToolTip.Tip="Odtwarza dźwięk przy każdym odpaleniu">
                <TextBlock Text="🔔" />
              </Border>
            </StackPanel>

            <ToggleButton Grid.Column="1" Classes="mud-switch"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          Content="{Binding StatusText}"
                          Click="ToggleTimer_OnClick"
                          ToolTip.Tip="Włącz / wyłącz timer" />

            <Button Grid.Column="2"
                    Classes="mud-small"
                    Content="✎" Padding="6,2"
                    ToolTip.Tip="Edytuj timer"
                    Click="EditTimer_OnClick" />

            <Button Grid.Column="3"
                    Classes="mud-small"
                    Content="⇩" Padding="6,2"
                    ToolTip.Tip="Eksportuj timer do JSON"
                    Click="ExportItem_OnClick" />

            <Button Grid.Column="4"
                    Classes="mud-small mud-danger"
                    Content="✕" Padding="6,2"
                    ToolTip.Tip="Usuń timer"
                    Click="DeleteTimer_OnClick" />
          </Grid>

          <Border Classes="mud-inset" Padding="8,5"
                  IsVisible="{Binding !DataContext.IsAutomationCompactView, ElementName=AutomationRoot}">
            <TextBlock Text="{Binding CommandsText}"
                       Foreground="{StaticResource MudBrushParchmentDim}"
                       TextWrapping="Wrap" />
          </Border>

          <!-- Inline editor — expands right under this row instead of jumping to the shared
               form at the top of the list (see MainWindowViewModel.EditTimer). -->
          <ContentControl IsVisible="{Binding IsEditing}"
                          Content="{Binding DataContext, ElementName=AutomationRoot}"
                          ContentTemplate="{StaticResource TimerEditorTemplate}"
                          Margin="0,4,0,0" />

        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Shared item template for aliases and triggers (rendered in two sections). -->
    <DataTemplate x:Key="RuleItemTemplate" x:DataType="models:AutomationRuleEntry">
      <Border Classes="mud-section" Padding="10,8" Margin="0,2">
        <StackPanel Spacing="4">

          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource MudBrushParchment}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding PatternAndActionSummary}" />
              <Border Classes="mud-badge mud-badge-gold" IsVisible="{Binding IsGlobal}"
                      ToolTip.Tip="Wspólna dla wszystkich kont">
                <TextBlock Text="Globalna" />
              </Border>
              <Border Classes="mud-badge" IsVisible="{Binding IsScript}"
                      ToolTip.Tip="Akcja to skrypt Lua">
                <TextBlock Text="Lua" />
              </Border>
              <Border Classes="mud-badge" IsVisible="{Binding PlaySoundOnMatch}"
                      ToolTip.Tip="Odtwarza dźwięk przy dopasowaniu">
                <TextBlock Text="🔔" />
              </Border>
            </StackPanel>
            <ToggleButton Grid.Column="1" Classes="mud-switch"
                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                          Content="{Binding StatusText}"
                          Click="ToggleRule_OnClick"
                          ToolTip.Tip="Włącz / wyłącz regułę" />
            <Button Grid.Column="2"
                    Classes="mud-small"
                    Content="✎" Padding="6,2"
                    ToolTip.Tip="Edytuj regułę"
                    Click="EditRule_OnClick" />
            <Button Grid.Column="3"
                    Classes="mud-small"
                    Content="⇩" Padding="6,2"
                    ToolTip.Tip="Eksportuj wpis do JSON"
                    Click="ExportItem_OnClick" />
            <Button Grid.Column="4"
                    Classes="mud-small mud-danger"
                    Content="✕" Padding="6,2"
                    ToolTip.Tip="Usuń regułę"
                    Click="DeleteRule_OnClick" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="1"
                IsVisible="{Binding !DataContext.IsAutomationCompactView, ElementName=AutomationRoot}">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mud-faint" Text="Wzorzec" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="mud-faint"
                       Text="{Binding Pattern}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Pattern}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="mud-faint" Text="Akcja" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mud-faint"
                       Text="{Binding Action}" TextWrapping="Wrap" />
          </Grid>

          <!-- Inline editor — expands right under this row instead of jumping to the shared
               form at the top of the list (see MainWindowViewModel.EditRule). -->
          <ContentControl IsVisible="{Binding IsEditing}"
                          Content="{Binding DataContext, ElementName=AutomationRoot}"
                          ContentTemplate="{StaticResource RuleEditorTemplate}"
                          Margin="0,4,0,0" />

        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="TimerEditorTemplate" x:DataType="vm:MainWindowViewModel">
      <StackPanel Spacing="8">
        <TextBox Text="{Binding NewTimerName}" PlaceholderText="Nazwa timera…" />
        <StackPanel Spacing="3">
          <TextBlock Classes="mud-faint" Text="Interwał powtarzania" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding NewTimerMinutes}" PlaceholderText="0" InnerRightContent="min" />
            <TextBox Grid.Column="1" Text="{Binding NewTimerSeconds}" PlaceholderText="0" InnerRightContent="s" />
            <TextBox Grid.Column="2" Text="{Binding NewTimerMilliseconds}" PlaceholderText="0" InnerRightContent="ms" />
          </Grid>
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Classes="mud-faint" Text="{Binding NewTimerCommandsLabel}" />
          <TextBox Text="{Binding NewTimerCommands}"
                   PlaceholderText="{Binding NewTimerCommandsPlaceholder}"
                   FontFamily="Consolas"
                   MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox IsChecked="{Binding NewTimerIsScript}"
                  Content="To skrypt Lua (uruchamiany co interwał, zamiast listy komend)" />
        <StackPanel Spacing="4" IsVisible="{Binding NewTimerIsScript}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Button Grid.Column="1" Content="▶ Testuj" Command="{Binding TestTimerScriptCommand}"
                    HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Odpala skrypt naraz, ze wspólną biblioteką i zmiennymi — jeśli zmienia licznik, zmiana zostaje na stałe, tak jakby faktycznie się odpalił." />
          <Border Classes="mud-inset" Padding="8,5" IsVisible="{Binding NewTimerTestOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding NewTimerTestOutput}" TextWrapping="Wrap" FontFamily="Consolas" />
          </Border>
        </StackPanel>
        <CheckBox IsChecked="{Binding NewTimerPlaySoundOnTick}"
                  Content="Odtwórz dźwięk przy każdym odpaleniu"
                  ToolTip.Tip="Krótki dźwięk systemowy za każdym razem, gdy ten timer się odpali." />
        <CheckBox IsChecked="{Binding NewTimerIsGlobal}"
                  Content="Globalny — dostępny na wszystkich kontach" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button Content="{Binding TimerFormButtonText}" Command="{Binding AddTimerCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="1" Content="Anuluj" Command="{Binding CancelTimerEditCommand}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RuleEditorTemplate" x:DataType="vm:MainWindowViewModel">
      <StackPanel Spacing="8">
        <TextBox Text="{Binding NewRuleName}" PlaceholderText="Nazwa…" />
        <StackPanel Spacing="3">
          <TextBlock Classes="mud-faint" Text="Wzorzec (regex .NET)" />
          <TextBox Text="{Binding NewRulePattern}"
                   PlaceholderText="np. ^zb (.+)$  albo  (\w+) upada na ziemie" />
          <TextBlock Text="{Binding NewRulePatternError}"
                     Foreground="{StaticResource MudBrushCrimsonBright}"
                     TextWrapping="Wrap" IsVisible="{Binding HasNewRulePatternError}" />
        </StackPanel>
        <StackPanel Spacing="3">
          <TextBlock Classes="mud-faint" Text="{Binding NewRuleActionLabel}" TextWrapping="Wrap" />
          <TextBox Text="{Binding NewRuleAction}"
                   PlaceholderText="{Binding NewRuleActionPlaceholder}"
                   FontFamily="Consolas"
                   MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox IsChecked="{Binding NewRuleIsScript}"
                  Content="To skrypt Lua (zamiast szablonu z $1, $2…)" />
        <CheckBox IsChecked="{Binding NewRulePlaySoundOnMatch}"
                  IsVisible="{Binding NewRuleIsTrigger}"
                  Content="Odtwórz dźwięk przy dopasowaniu"
                  ToolTip.Tip="Krótki dźwięk systemowy za każdym razem, gdy ten trigger się odpali." />
        <StackPanel Spacing="4" IsVisible="{Binding NewRuleIsScript}">
          <TextBlock Classes="mud-faint" Text="Testuj — wpisana komenda (alias) lub linia z MUD-a (trigger)" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding NewRuleTestInput}"
                     PlaceholderText="np. kk orc  albo  Zabijasz golema." />
            <Button Grid.Column="1" Content="▶ Testuj" Command="{Binding TestRuleScriptCommand}" />
          </Grid>
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Odpala skrypt naraz, ze wspólną biblioteką i zmiennymi — jeśli zmienia licznik, zmiana zostaje na stałe, tak jakby faktycznie się odpalił." />
          <Border Classes="mud-inset" Padding="8,5" IsVisible="{Binding NewRuleTestOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding NewRuleTestOutput}" TextWrapping="Wrap" FontFamily="Consolas" />
          </Border>
        </StackPanel>
        <CheckBox IsChecked="{Binding NewRuleIsGlobal}"
                  Content="Globalny — dostępny na wszystkich kontach" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button Content="{Binding RuleFormButtonText}" Command="{Binding AddRuleCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="1" Content="Anuluj" Command="{Binding CancelRuleEditCommand}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <TabControl Classes="mud-subtabs mud-automation-tabs"
              SelectedIndex="{Binding SelectedAutomationTabIndex, Mode=TwoWay}">
    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Timery" />
          <Border Classes="mud-badge"><TextBlock Text="{Binding Timers.Count}" /></Border>
        </StackPanel>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <Button Content="＋ Nowy timer" Command="{Binding StartAddTimerCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="mud-small" Content="☰ Kompaktowo"
                          IsChecked="{Binding IsAutomationCompactView}"
                          ToolTip.Tip="Ukryj podgląd komend na liście — sama nazwa, przełącznik i odznaki" />
            <Button Grid.Column="2" Classes="mud-small" Content="📁 Folder"
                    ToolTip.Tip="Utwórz folder na timery"
                    Command="{Binding CreateFolderCommand}"
                    CommandParameter="{x:Static models:FolderKind.Timers}" />
            <Button Grid.Column="3" Classes="mud-small" Content="⇧ JSON"
                    ToolTip.Tip="Importuj timery lub folder z pliku JSON"
                    Tag="{x:Static models:FolderKind.Timers}" Click="Import_OnClick" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">

      <Expander Classes="mud-expander"
                Header="{Binding TimerFormHeader}"
                IsExpanded="{Binding IsTimerFormExpanded}"
                IsVisible="{Binding IsTimerFormExpanded}">
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource TimerEditorTemplate}"
                        Margin="0,8,0,0" />
      </Expander>

      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Brak timerów. Timer powtarza komendy w nieskończoność, dopóki go nie wyłączysz."
                 IsVisible="{Binding !Timers.Count}" />

      <TextBox Text="{Binding TimerFilterText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Szukaj po nazwie lub komendach..."
               IsVisible="{Binding Timers.Count}" />

      <controls:FolderTreeView Nodes="{Binding TimerTree}"
                               ItemTemplate="{StaticResource TimerItemTemplate}"
                               SupportsEnableToggle="True"
                               SupportsExport="True"
                               FolderExportRequested="FolderTree_OnFolderExportRequested"
                               MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                               CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                               RenameFolderCommand="{Binding RenameFolderCommand}"
                               DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=AutomationRoot}"
                               ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                               ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Aliasy" />
          <Border Classes="mud-badge"><TextBlock Text="{Binding AliasRules.Count}" /></Border>
        </StackPanel>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <Button Content="＋ Nowy alias" Command="{Binding StartAddAliasCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="mud-small" Content="☰ Kompaktowo"
                          IsChecked="{Binding IsAutomationCompactView}"
                          ToolTip.Tip="Ukryj podgląd wzorca/akcji na liście — sama nazwa, przełącznik i odznaki" />
            <Button Grid.Column="2" Classes="mud-small" Content="📁 Folder"
                    ToolTip.Tip="Utwórz folder na aliasy"
                    Command="{Binding CreateFolderCommand}"
                    CommandParameter="{x:Static models:FolderKind.Aliases}" />
            <Button Grid.Column="3" Classes="mud-small" Content="⇧ JSON"
                    ToolTip.Tip="Importuj alias lub folder z pliku JSON"
                    Tag="{x:Static models:FolderKind.Aliases}" Click="Import_OnClick" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">
            <Expander Classes="mud-expander"
                      Header="{Binding RuleFormHeader}"
                      IsExpanded="{Binding IsRuleFormExpanded}"
                      IsVisible="{Binding IsAliasRuleFormVisible}">
              <ContentControl Content="{Binding}"
                              ContentTemplate="{StaticResource RuleEditorTemplate}"
                              Margin="0,8,0,0" />
            </Expander>

      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Brak aliasów. Alias podmienia komendę, którą wpisujesz (np. skrót)."
                 IsVisible="{Binding !AliasRules.Count}" />

      <TextBox Text="{Binding AliasFilterText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Szukaj po nazwie, wzorcu lub akcji..."
               IsVisible="{Binding AliasRules.Count}" />

      <controls:FolderTreeView Nodes="{Binding AliasTree}"
                               ItemTemplate="{StaticResource RuleItemTemplate}"
                               SupportsEnableToggle="True"
                               SupportsExport="True"
                               FolderExportRequested="FolderTree_OnFolderExportRequested"
                               MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                               CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                               RenameFolderCommand="{Binding RenameFolderCommand}"
                               DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=AutomationRoot}"
                               ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                               ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem>
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Triggery" />
          <Border Classes="mud-badge"><TextBlock Text="{Binding TriggerRules.Count}" /></Border>
        </StackPanel>
      </TabItem.Header>
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <Button Content="＋ Nowy trigger" Command="{Binding StartAddTriggerCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ToggleButton Grid.Column="1" Classes="mud-small" Content="☰ Kompaktowo"
                          IsChecked="{Binding IsAutomationCompactView}"
                          ToolTip.Tip="Ukryj podgląd wzorca/akcji na liście — sama nazwa, przełącznik i odznaki" />
            <Button Grid.Column="2" Classes="mud-small" Content="📁 Folder"
                    ToolTip.Tip="Utwórz folder na triggery"
                    Command="{Binding CreateFolderCommand}"
                    CommandParameter="{x:Static models:FolderKind.Triggers}" />
            <Button Grid.Column="3" Classes="mud-small" Content="⇧ JSON"
                    ToolTip.Tip="Importuj trigger lub folder z pliku JSON"
                    Tag="{x:Static models:FolderKind.Triggers}" Click="Import_OnClick" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">
            <Expander Classes="mud-expander"
                      Header="{Binding RuleFormHeader}"
                      IsExpanded="{Binding IsRuleFormExpanded}"
                      IsVisible="{Binding IsTriggerRuleFormVisible}">
              <ContentControl Content="{Binding}"
                              ContentTemplate="{StaticResource RuleEditorTemplate}"
                              Margin="0,8,0,0" />
            </Expander>

      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Brak triggerów. Trigger wysyła akcję, gdy linia z serwera pasuje do wzorca."
                 IsVisible="{Binding !TriggerRules.Count}" />

      <TextBox Text="{Binding TriggerFilterText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Szukaj po nazwie, wzorcu lub akcji..."
               IsVisible="{Binding TriggerRules.Count}" />

      <controls:FolderTreeView Nodes="{Binding TriggerTree}"
                               ItemTemplate="{StaticResource RuleItemTemplate}"
                               SupportsEnableToggle="True"
                               SupportsExport="True"
                               FolderExportRequested="FolderTree_OnFolderExportRequested"
                               MoveIntoFolderCommand="{Binding MoveIntoFolderCommand}"
                               CreateSubfolderCommand="{Binding CreateSubfolderCommand}"
                               RenameFolderCommand="{Binding RenameFolderCommand}"
                               DeleteFolderCommand="{Binding ConfirmDeleteFolderCommand, ElementName=AutomationRoot}"
                               ToggleFolderGlobalCommand="{Binding ToggleFolderGlobalCommand}"
                               ToggleFolderEnabledCommand="{Binding ToggleFolderEnabledCommand}" />

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <TabItem Header="Biblioteka Lua">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="mud-bar-bottom">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Funkcje/zmienne zdefiniowane tutaj są dostępne w każdym skrypcie Lua (aliasie, triggerze, timerze) na tym koncie — biblioteka wczytuje się raz przy aktywacji konta, zanim jakikolwiek skrypt zdąży się odpalić. Nie służy do wysyłania komend (send() tutaj nic nie zrobi) — tylko do definiowania rzeczy współdzielonych." />
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8" Margin="10,8,10,12">
            <TextBox Text="{Binding LuaLibrarySource}"
                     PlaceholderText="np.&#x0a;function isBoss(name)&#x0a;  return name == &quot;smok&quot; or name == &quot;lisz&quot;&#x0a;end"
                     FontFamily="Consolas"
                     MinHeight="320" AcceptsReturn="True" TextWrapping="Wrap"
                     AcceptsTab="True" />
            <Button Content="Zapisz i wczytaj" Command="{Binding ApplyLuaLibraryCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

  </TabControl>
</UserControl>
