<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:MudClient.App.Controls" xmlns:equipment="using:MudClient.Core.Equipment" xmlns:gmcp="using:MudClient.Core.Gmcp" xmlns:vm="using:MudClient.App.ViewModels" x:Class="MudClient.App.Views.Panels.EquipmentInventoryPanelView" x:Name="EquipmentInventoryPanel" x:DataType="vm:MainWindowViewModel">
  <TabControl Classes="mud-subtabs">
    <TabItem Header="Equipment"><ScrollViewer><StackPanel Margin="6" Spacing="2">
      <TextBlock Text="{Binding EquipmentInventory.StatusText}" Classes="mud-faint" FontSize="11"/>
      <ItemsControl ItemsSource="{Binding EquipmentInventory.Equipment}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:EquipmentInventoryRow">
        <Border Classes="mud-section" Padding="4" Margin="0,1"><ToolTip.Tip><TextBlock Text="{Binding ExamineDescription}" TextWrapping="NoWrap"/></ToolTip.Tip><Border.ContextMenu><ContextMenu><MenuItem Header="Zbadaj" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteEquipmentExamineCommand}" CommandParameter="{Binding}"/><Separator/><MenuItem Header="Zdejmij" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteEquipmentRemoveCommand}" CommandParameter="{Binding}"/><Separator/><MenuItem Header="Wstaw nazwę do linii poleceń" Command="{Binding #EquipmentInventoryPanel.DataContext.InsertEquipmentItemNameToCommandBarCommand}" CommandParameter="{Binding}"/></ContextMenu></Border.ContextMenu><Grid ColumnDefinitions="150,Auto,*,Auto"><TextBlock Text="{Binding Location}" Classes="mud-faint" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding DurabilityWarningText}" Classes="mud-status-bad" FontSize="11" Margin="0,0,5,0"/><controls:AnsiTextBlock Grid.Column="2" AnsiText="{Binding Name}" TextWrapping="Wrap" FontSize="12"/><TextBlock Grid.Column="3" Text="{Binding DurabilityWarningText}" Classes="mud-status-bad" FontSize="11" Margin="5,0,0,0"/></Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Classes="mud-section" Padding="5" Margin="0,4,0,0"><StackPanel Spacing="2"><TextBlock Text="Suma rozpoznanych bonusów" Classes="mud-faint" FontSize="11"/><TextBlock Text="{Binding EquipmentInventory.BonusSummaryText}" TextWrapping="Wrap" FontSize="12"/><ItemsControl ItemsSource="{Binding EquipmentInventory.BonusSummary}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:EquipmentBonusSummaryRow"><StackPanel Spacing="1"><TextBlock Text="{Binding Category}" Classes="mud-faint" FontSize="11" Margin="0,3,0,0" IsVisible="{Binding HasCategory}"/><TextBlock Text="{Binding Text}" ToolTip.Tip="{Binding Sources}" FontSize="12"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Inventory"><ScrollViewer><StackPanel Margin="6" Spacing="2">
      <TextBlock Text="{Binding EquipmentInventory.StatusText}" Classes="mud-faint" FontSize="11"/>
      <ItemsControl ItemsSource="{Binding EquipmentInventory.Inventory}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:EquipmentInventoryRow">
        <Border Classes="mud-section" Padding="4" Margin="0,1">
          <ToolTip.Tip><TextBlock Text="{Binding ExamineDescription}" TextWrapping="NoWrap"/></ToolTip.Tip>
          <Border.ContextMenu><ContextMenu>
            <MenuItem Header="Zbadaj" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventoryExamineCommand}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Identyfikacja u specjalisty" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventorySpecialistIdentifyCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="Identyfikuj" IsVisible="{Binding #EquipmentInventoryPanel.DataContext.CanIdentifyItemsWithSpell}" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventorySpellIdentifyCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="Daj przedmiot" Tag="{Binding}" ItemsSource="{Binding #EquipmentInventoryPanel.DataContext.InventoryGiveTargets}" Click="GiveInventoryItem_OnClick"><MenuItem.ItemTemplate><DataTemplate x:DataType="gmcp:RoomPerson"><MenuItem Header="{Binding Name}"/></DataTemplate></MenuItem.ItemTemplate></MenuItem>
            <MenuItem Header="Wyjmij" IsVisible="{Binding IsIdentifiedContainer}" Tag="{Binding}" ItemsSource="{Binding ContainerContentsOrEmpty}" Click="TakeContainerItem_OnClick"><MenuItem.ItemTemplate><DataTemplate x:DataType="vm:ContainerInventoryItem"><MenuItem Header="{Binding MenuDisplayName}" FontSize="10" Padding="6,1" MinHeight="0" Margin="0"/></DataTemplate></MenuItem.ItemTemplate></MenuItem>
            <MenuItem Header="Włóż do" Tag="{Binding}" ItemsSource="{Binding #EquipmentInventoryPanel.DataContext.InventoryContainers}" Click="PutInventoryItem_OnClick"><MenuItem.ItemTemplate><DataTemplate x:DataType="vm:EquipmentInventoryRow"><MenuItem Header="{Binding MenuDisplayName}" FontSize="10" Padding="6,1" MinHeight="0" Margin="0"/></DataTemplate></MenuItem.ItemTemplate></MenuItem>
            <Separator/>
            <MenuItem Header="Załóż" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventoryWearCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="Trzymaj" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventoryHoldCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="Użyj jako broni" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventoryWieldCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="Upuść" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventoryDropCommand}" CommandParameter="{Binding}"/>
            <MenuItem Header="Sprzedaj" Command="{Binding #EquipmentInventoryPanel.DataContext.ExecuteInventorySellCommand}" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Wstaw nazwę do linii poleceń" Command="{Binding #EquipmentInventoryPanel.DataContext.InsertEquipmentItemNameToCommandBarCommand}" CommandParameter="{Binding}"/>
          </ContextMenu></Border.ContextMenu>
          <Grid ColumnDefinitions="Auto,*,Auto"><TextBlock Text="{Binding DurabilityWarningText}" Classes="mud-status-bad" FontSize="11" Margin="0,0,5,0"/><controls:AnsiTextBlock Grid.Column="1" AnsiText="{Binding Name}" TextWrapping="Wrap" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding DurabilityWarningText}" Classes="mud-status-bad" FontSize="11" Margin="5,0,0,0"/></Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Tatuaże"><ScrollViewer><StackPanel Margin="6" Spacing="2">
      <TextBlock Text="Tatuaże odczytane z examine self." Classes="mud-faint" FontSize="11"/>
      <ItemsControl ItemsSource="{Binding EquipmentInventory.Tattoos}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="equipment:TattooItem">
        <Border Classes="mud-section" Padding="4" Margin="0,1"><ToolTip.Tip><TextBlock Text="{Binding Description}" TextWrapping="NoWrap"/></ToolTip.Tip><StackPanel Spacing="2"><Grid ColumnDefinitions="110,*"><TextBlock Text="{Binding Location}" Classes="mud-faint" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" FontSize="12"/></Grid><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Margin="110,0,0,0"/></StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
  </TabControl>
</UserControl>
