<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.FarmAutomationPanelView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8" Margin="10,8,10,12">
      <TextBlock Classes="mud-heading" Text="Auto-farma" />
      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Chodzi po nieodwiedzonych pokojach w obszarze zaznaczonym na mapie (⚙ Ustawienia mapy → Obszar farmy, albo „Zaznacz obszar” w menu prawego przycisku mapy), pozwalając Autokillowi (poniżej) walczyć po drodze. Gdy HP spadnie do progu poniżej, farma przerywa chodzenie i leczy się/odpoczywa zamiast iść dalej." />

      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap" Text="{Binding Map.AutoFarmRegionStatusText}" />
          <TextBlock Classes="mud-faint" TextWrapping="Wrap" Text="{Binding AutoFarmStatusText}" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Content="Uruchom farmę"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding StartAutoFarmCommand}" />
            <Button Grid.Column="1" Content="Pauza"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsVisible="{Binding !IsAutoFarmPaused}"
                    ToolTip.Tip="Wstrzymaj chodzenie, zachowując dotychczasowy postęp — w przeciwieństwie do „Zatrzymaj farmę” wznowienie nie zacznie trasy od nowa."
                    Command="{Binding PauseAutoFarmCommand}" />
            <Button Grid.Column="1" Content="Wznów"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsVisible="{Binding IsAutoFarmPaused}"
                    Command="{Binding ResumeAutoFarmCommand}" />
            <Button Grid.Column="2" Content="Zatrzymaj farmę"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding StopAutoFarmCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Leczenie i odpoczynek" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Próg HP" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding AutoFarmHpThresholdPercent, StringFormat='{}{0}%'}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinAutoFarmHpThresholdPercent}"
                    Maximum="{Binding MaxAutoFarmHpThresholdPercent}"
                    Value="{Binding AutoFarmHpThresholdPercent}"
                    TickFrequency="5" IsSnapToTickEnabled="True" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Farma przerywa chodzenie i zaczyna się leczyć, gdy aktualne HP spadnie do tego procentu maksimum lub niżej." />
          </StackPanel>

          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Odczekaj po wejściu do pokoju" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding AutoFarmStepDelayMilliseconds, StringFormat='{}{0} ms'}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinAutoFarmStepDelayMilliseconds}"
                    Maximum="{Binding MaxAutoFarmStepDelayMilliseconds}"
                    Value="{Binding AutoFarmStepDelayMilliseconds}"
                    TickFrequency="500" IsSnapToTickEnabled="True" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Zanim farma ruszy do kolejnego pokoju, czeka tyle po wejściu — przydatne, gdy triggery na wejście do pokoju (zbieractwo, obdzieranie ze skóry, ...) nie nadążają za szybkim chodzeniem i psują kolejkę poleceń. 0 = bez opóźnienia (domyślnie)." />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Zaklęcia leczące (rzucane na siebie, od najsilniejszego)" />
            <TextBox Text="{Binding AutoFarmHealSpellNamesText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedno zaklęcie na linię, najsilniejsze na górze&#x0a;np. cure critical&#x0a;cure serious&#x0a;cure light" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy HP spadnie poniżej progu: farma rzuca najsilniejsze z tych zaklęć, które akurat ma zapamiętane; jeśli żadne nie jest zapamiętane, memuje najsilniejsze z listy — a przy okazji zawsze też odpoczywa (używa czasu odpoczynku ustawionego w module „Auto: Podróż”). Puste pole = tylko odpoczynek." />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Zaklęcia zawsze zapamiętane (obczarka)" />
            <TextBox Text="{Binding AutoFarmMemSpellsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedno zaklęcie na linię, np. armor&#x0a;bless&#x0a;~haste" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Farma sprawdza to razem z progiem HP. Zwykła linia = wymagane: jeśli brakuje, przerywa chodzenie, memuje i odpoczywa, tak samo jak przy zaklęciu leczącym. Linia zaczynająca się od „~” = przy okazji: memowana tylko wtedy, gdy farma i tak już się zatrzymała (HP lub inne wymagane zaklęcie) — sama z siebie nigdy nie przerywa chodzenia." />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Zaklęcia rzucane po zaatakowaniu przeciwnika (w tej kolejności)" />
            <TextBox Text="{Binding AutoFarmCastSpellsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedno zaklęcie na linię, w kolejności rzucania&#x0a;np. armor&#x0a;bless&#x0a;!magic missile" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy tylko rozpocznie się walka (nie samo wejście do pokoju), farma pomija buffy, które już są aktywne, i rzuca resztę po kolei na siebie. Linia zaczynająca się od „!” to zaklęcie ofensywne — leci w przeciwnika, z którym akurat walczysz, i rzucane jest zawsze (bez sprawdzania aktywnych efektów). Jeśli któregoś brakuje w pamięci, farma zadba o to wcześniej — przy wejściu do pokoju przerywa chodzenie, memuje i odpoczywa, tak samo jak przy zaklęciu leczącym — więc w trakcie walki nic nie musi memować." />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Autokill" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding Map.AutoKillOnRoomEnter}"
                      Content="Autokill — atakuj po wejściu do pokoju" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Po każdym wejściu do nowego pokoju klient wysyła „kill &lt;nazwa&gt;” tylko dla tych nazw poniżej, które faktycznie znajdują się w pokoju." />
            <TextBox Text="{Binding Map.AutoKillMobNamesText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Map.AutoKillOnRoomEnter}"
                     PlaceholderText="Jedna nazwa moba na linię, np. strażnik&#x0a;keton" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
