<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.FarmAutomationPanelView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8" Margin="10,8,10,12">
      <TextBlock Classes="mud-heading" Text="Auto-farma" />
      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Chodzi po nieodwiedzonych pokojach w obszarze zaznaczonym na mapie (⚙ Ustawienia mapy → Obszar farmy, albo „Zaznacz obszar” w menu prawego przycisku mapy), pozwalając Autokillowi (poniżej) walczyć po drodze. Gdy HP spadnie do progu poniżej, farma przerywa chodzenie i leczy się/odpoczywa zamiast iść dalej." />

      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap" Text="{Binding Map.AutoFarmRegionStatusText}" />
          <TextBlock Classes="mud-faint" TextWrapping="Wrap" Text="{Binding AutoFarmStatusText}" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Content="Uruchom farmę"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding StartAutoFarmCommand}" />
            <Button Grid.Column="1" Content="Pauza"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsVisible="{Binding !IsAutoFarmPaused}"
                    ToolTip.Tip="Wstrzymaj chodzenie, zachowując dotychczasowy postęp — w przeciwieństwie do „Zatrzymaj farmę” wznowienie nie zacznie trasy od nowa."
                    Command="{Binding PauseAutoFarmCommand}" />
            <Button Grid.Column="1" Content="Wznów"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsVisible="{Binding IsAutoFarmPaused}"
                    Command="{Binding ResumeAutoFarmCommand}" />
            <Button Grid.Column="2" Content="Zatrzymaj farmę"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding StopAutoFarmCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Leczenie i odpoczynek" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutoSelfHealEnabled}"
                      Content="Autoleczenie — lecz się sam poniżej progu, nawet bez uruchomionej farmy" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Ta sama reakcja co w farmie, ale działa niezależnie od niej — rzuca najsilniejsze z „Zaklęć leczących” poniżej, które akurat jest zapamiętane, gdy tylko HP spadnie poniżej progu. Nie memuje ani nie odpoczywa (to wymaga chodzenia po pokojach farmy) — przydatne dla postaci, która tylko podąża za liderem (Autofollow, Automaty → Podróż) i sama nie może się zamemować." />
          </StackPanel>

          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Próg HP" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding AutoFarmHpThresholdPercent, StringFormat='{}{0}%'}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinAutoFarmHpThresholdPercent}"
                    Maximum="{Binding MaxAutoFarmHpThresholdPercent}"
                    Value="{Binding AutoFarmHpThresholdPercent}"
                    TickFrequency="5" IsSnapToTickEnabled="True" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Farma przerywa chodzenie i zaczyna się leczyć, gdy aktualne HP spadnie do tego procentu maksimum lub niżej." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutoFarmHealOrderEnabled}"
                      Content="Ordery lecznicze — każ drużynie się leczyć, gdy moje HP spadnie poniżej progu" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Ten sam próg HP powyżej: gdy Twoje HP spadnie poniżej niego, klient wyśle poniższe zaklęcia jako „order &lt;członek&gt; cast &quot;&lt;zaklęcie&gt;&quot; self” do każdego innego członka drużyny (raz na spadek HP — nie spamuje, dopóki nie wrócisz powyżej progu). Wymaga bycia liderem drużyny GMCP, tak jak zwykłe „order” — jeśli nie jesteś liderem, użyj zamiast tego „Zdalnego sterowania” w panelu Automaty → Drużyna." />
            <TextBox MinHeight="64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedno zaklęcie na linię, np. cure critical&#x0a;cure serious"
                     Text="{Binding AutoFarmHealOrderSpellNamesText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Możesz wpisać wiele wierszy lub rozdzielić nazwy separatorem ustawionym w opcjach klienta — każde zaklęcie zostanie zlecone każdemu członkowi drużyny." />
            <CheckBox IsChecked="{Binding AutoFarmHealOrderMemEnabled}"
                      Content="Domemuj, gdy trzeba" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Przed każdym „cast” wyśle też „order &lt;członek&gt; mem &quot;&lt;zaklęcie&gt;&quot;”. Klient nie widzi, czy dany członek ma akurat to zaklęcie zapamiętane (GMCP podaje tylko ile mu zostało punktów pamięci, nie które zaklęcia zna), więc zlecenie mema leci za każdym razem — u kogoś, kto już je ma zapamiętane, to nic nie zmienia, a u kogoś, komu się skończyło, zostanie zapamiętane na czas kolejnego spadku HP." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutoFarmRestOrderEnabled}"
                      Content="Ordery odpoczynku — każ drużynie odpoczywać, gdy Ty wchodzisz w kolejny pokój" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Przed każdym wejściem do kolejnego pokoju farmy wyśle „order &lt;członek&gt; rest” do każdego innego członka drużyny, który akurat nie odpoczywa. Pomyślane do wchodzenia w lokacje z agresywnymi mobami atakującymi losowy cel — drużyna zostaje na miejscu, odpoczywając (więc zwykle poza pulą losowych celów), a idziesz i walczysz tylko Ty. Warto połączyć z buforem utrzymywanym stale na sobie (patrz „Bufory utrzymywane na sobie i zaklęcia ofensywne” poniżej — zwykła linia bez „!”) oraz z Autofollow (Automaty → Podróż) po stronie towarzysza, żeby dogonił Cię, gdy skończysz." />
          </StackPanel>

          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Odczekaj po wejściu do pokoju" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding AutoFarmStepDelayMilliseconds, StringFormat='{}{0} ms'}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinAutoFarmStepDelayMilliseconds}"
                    Maximum="{Binding MaxAutoFarmStepDelayMilliseconds}"
                    Value="{Binding AutoFarmStepDelayMilliseconds}"
                    TickFrequency="500" IsSnapToTickEnabled="True" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Zanim farma ruszy do kolejnego pokoju, czeka tyle po wejściu — przydatne, gdy triggery na wejście do pokoju (zbieractwo, obdzieranie ze skóry, ...) nie nadążają za szybkim chodzeniem i psują kolejkę poleceń. 0 = bez opóźnienia (domyślnie)." />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Zaklęcia leczące (rzucane na siebie, od najsilniejszego)" />
            <TextBox Text="{Binding AutoFarmHealSpellNamesText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedno zaklęcie na linię, najsilniejsze na górze&#x0a;np. cure critical&#x0a;cure serious&#x0a;cure light" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy HP spadnie poniżej progu: farma rzuca najsilniejsze z tych zaklęć, które akurat ma zapamiętane; jeśli żadne nie jest zapamiętane, memuje najsilniejsze z listy — a przy okazji zawsze też odpoczywa (używa czasu odpoczynku ustawionego w module „Auto: Podróż”). Puste pole = tylko odpoczynek." />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Zaklęcia zawsze zapamiętane (obczarka)" />
            <TextBox Text="{Binding AutoFarmMemSpellsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedno zaklęcie na linię, np. armor&#x0a;bless&#x0a;~haste" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Farma sprawdza to razem z progiem HP. Zwykła linia = wymagane: jeśli brakuje, przerywa chodzenie, memuje i odpoczywa, tak samo jak przy zaklęciu leczącym. Linia zaczynająca się od „~” = przy okazji: memowana tylko wtedy, gdy farma i tak już się zatrzymała (HP lub inne wymagane zaklęcie) — sama z siebie nigdy nie przerywa chodzenia." />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Bufory utrzymywane na sobie i zaklęcia ofensywne (w tej kolejności)" />
            <TextBox Text="{Binding AutoFarmCastSpellsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedno zaklęcie na linię, w kolejności rzucania&#x0a;np. armor&#x0a;bless&#x0a;!magic missile" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Zwykła linia (bez „!”) to bufor utrzymywany na sobie przez cały czas trwania farmy — sprawdzany przed każdym wejściem do kolejnego pokoju, nie tylko przy starcie walki: jeśli nie jest zapamiętany, farma przerywa chodzenie, memuje i odpoczywa (tak samo jak przy zaklęciu leczącym); jeśli jest zapamiętany, ale akurat wygasł, zostaje od razu rzucony na siebie, zanim farma pójdzie dalej. Linia zaczynająca się od „!” to zaklęcie ofensywne — w odróżnieniu od bufora leci wyłącznie przy starcie walki (dopiero wtedy jest kogo trafić), zawsze w przeciwnika, z którym akurat walczysz, i zawsze rzucane, bez sprawdzania aktywnych efektów." />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Umiejętności uruchamiane po zaatakowaniu przeciwnika (w tej kolejności)" />
            <TextBox Text="{Binding AutoFarmSkillsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     PlaceholderText="Jedna umiejętność na linię, w kolejności użycia&#x0a;np. berserk&#x0a;!kick" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="To samo co zaklęcia powyżej, ale dla umiejętności (np. kopnięcie) zamiast czarów — bez memowania: umiejętność jest gotowa, gdy tylko zejdzie z odnowienia. Gdy tylko rozpocznie się walka i dalej przez cały jej czas (w miarę jak kolejne umiejętności schodzą z odnowienia), farma pomija te już aktywne na sobie i używa reszty po kolei. Linia zaczynająca się od „!” to umiejętność ofensywna — leci w przeciwnika, z którym akurat walczysz, i używana jest zawsze, gdy tylko gotowa; bez „!” to umiejętność użyta na sobie (np. berserk), pomijana, gdy już aktywna." />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Autokill" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding Map.AutoKillOnRoomEnter}"
                      Content="Autokill — atakuj po wejściu do pokoju" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Po każdym wejściu do nowego pokoju klient wysyła „kill &lt;nazwa&gt;” tylko dla tych nazw poniżej, które faktycznie znajdują się w pokoju." />
            <TextBox Text="{Binding Map.AutoKillMobNamesText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="70"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Map.AutoKillOnRoomEnter}"
                     PlaceholderText="Jedna nazwa moba na linię, np. strażnik&#x0a;keton" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
