<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:conv="using:MudClient.App.Converters"
             x:Class="MudClient.App.Views.Panels.GroupPanelView"
             x:Name="GroupPanel"
             x:DataType="vm:MainWindowViewModel">
  <!-- Group (live from Char.Group GMCP) -->
  <ScrollViewer>
    <StackPanel Spacing="2" Margin="12">
      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="{Binding GroupEmptyMessage}"
                 IsVisible="{Binding !Group.Count}" />
      <ItemsControl x:Name="GroupMembersList" ItemsSource="{Binding Group}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:GroupMember">
            <Border Classes="mud-section" Classes.mud-self-row="{Binding IsSelf}"
                    Padding="6,3" Margin="0,1">
              <Border.ContextMenu>
                <ContextMenu x:DataType="models:GroupMember"
                             Opened="GroupContextMenu_OnOpened"
                             Closed="GroupContextMenu_OnClosed">
                  <MenuItem Header="walk room"
                            Command="{Binding #GroupPanel.DataContext.LordGotoGroupRoomCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding #GroupPanel.DataContext.LordModeEnabled}" />
                  <MenuItem Header="{Binding Name, StringFormat='walk {0}'}"
                            Command="{Binding #GroupPanel.DataContext.LordGotoGroupMemberCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding #GroupPanel.DataContext.LordModeEnabled}" />
                </ContextMenu>
              </Border.ContextMenu>
              <StackPanel Spacing="3">
                <!-- Everything but the bars on one line: leader marker, name, NPC tag, position,
                     mem, room. Room takes the remaining space and ellipsizes — everything else is
                     short and fixed-width, so this is the one column worth letting grow. -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="{Binding LeaderMarker}"
                             Foreground="{StaticResource MudBrushGoldBright}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}"
                             MaxWidth="140" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Name}" />
                  <Border Grid.Column="2" Classes="mud-status-chip" Padding="4,0"
                          IsVisible="{Binding IsSelf}">
                    <TextBlock Text="TY" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushEmerald}" />
                  </Border>
                  <Border Grid.Column="2" Classes="mud-status-chip" Padding="4,0"
                          IsVisible="{Binding IsNpc}">
                    <TextBlock Text="NPC" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource MudBrushAmberWarn}" />
                  </Border>
                  <TextBlock Grid.Column="3" Foreground="{StaticResource MudBrushParchmentDim}"
                             ToolTip.Tip="Pozycja"
                             Text="{Binding PositionDisplay}" />
                  <TextBlock Grid.Column="4" Foreground="{StaticResource MudBrushArcaneBlueBright}"
                             Text="{Binding MemDisplay}"
                             IsVisible="{Binding MemDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Grid.Column="5" Foreground="{StaticResource MudBrushParchmentFaint}"
                             ToolTip.Tip="Pokój"
                             Text="{Binding RoomDisplay}"
                             TextTrimming="CharacterEllipsis"
                             HorizontalAlignment="Right" />
                </Grid>
                <!-- HP + MV side by side instead of stacked — halves the height these two bars
                     cost, so more members fit in the panel at once. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="5" CornerRadius="2"
                               Value="{Binding HpPercent}"
                               Foreground="{StaticResource MudBrushCrimson}"
                               ToolTip.Tip="{Binding HpDisplay}" />
                  <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="5" CornerRadius="2"
                               Value="{Binding MvPercent}"
                               Foreground="{StaticResource MudBrushEmerald}"
                               ToolTip.Tip="{Binding MvDisplay}" />
                </Grid>
                <!-- User-defined spell shortcuts (edited via the ⚙ button in this panel's own
                     title bar — see GroupSettingsButton in PanelToolView.axaml), one small
                     button per shortcut, each casting on this specific member when clicked. The
                     member is carried through via Tag (bound to this row's own DataContext, i.e.
                     the GroupMember) rather than a second CommandParameter — Avalonia has no
                     built-in way to pass both the outer row's item and the inner list's item to
                     one command, and this codebase has no MultiBinding precedent for it either. -->
                <ItemsControl ItemsSource="{Binding #GroupPanel.DataContext.GroupSpells}"
                              Tag="{Binding}"
                              IsVisible="{Binding #GroupPanel.DataContext.GroupSpells.Count}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:GroupSpellShortcut">
                      <!-- Background reddens when SpellName isn't currently memorized (see
                           MainWindowViewModel.MemorizedSpellNames) — a quick warning that clicking
                           this will fail rather than cast. Reached via #GroupPanel (named-element
                           lookup, not $parent index) since $parent[ItemsControl] here is the
                           per-member spell ItemsControl, whose own DataContext is the GroupMember,
                           not MainWindowViewModel — same reasoning as GroupSpells' ItemsSource
                           above. -->
                      <Button Classes="mud-small"
                              Content="{Binding Label}"
                              Tag="{Binding $parent[ItemsControl].Tag}"
                              Click="OnCastGroupSpellClick"
                              ToolTip.Tip="{Binding SpellName}"
                              Margin="0,0,4,4">
                        <Button.Background>
                          <MultiBinding Converter="{x:Static conv:SpellMemorizedBrushConverter.Instance}">
                            <Binding Path="SpellName" />
                            <Binding ElementName="GroupPanel" Path="DataContext.MemorizedSpellNames" />
                          </MultiBinding>
                        </Button.Background>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
