<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MudClient.App.Controls"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:map="using:MudClient.Core.Map"
             xmlns:models="using:MudClient.App.Models"
             x:Class="MudClient.App.Views.Panels.MapPanelView"
             x:DataType="vm:MapViewModel">
  <UserControl.Styles>
    <Style Selector="Button.movement-button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.movement-key">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Background" Value="{StaticResource MudBrushStone}" />
      <Setter Property="BorderBrush" Value="{StaticResource MudBrushGoldDim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Border.movement-key TextBlock">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto,Auto,Auto">

    <!-- ========================================================================
          Map content area (the "Mapa ▾" menu floats over its top-left corner —
          see below — instead of taking its own header row).
          ======================================================================== -->
    <Border Grid.Row="0" Background="Black">
      <Panel>
        <controls:WorldMapControl x:Name="MapControl"
                                  WidgetFontFamily="{DynamicResource WidgetFontFamilyResource}"
                                  WidgetFontSize="{DynamicResource WidgetFontSizeResource}"
                                  WidgetFontWeight="{DynamicResource WidgetFontWeightResource}">
          <controls:WorldMapControl.ContextMenu>
            <ContextMenu>
              <!-- Opens SearchRoomDialog for a vnum, then centers/selects it via
                   MapViewModel.FocusRoomByVnum (see SearchRoom_OnClick in the code-behind). -->
              <MenuItem Header="Szukaj pokój (vnum)..."
                        Click="SearchRoom_OnClick" />
              <!-- Opens SearchTeacherDialog — an autocompleting closed list of known teachers and
                   spellbook mobs (MapViewModel.SearchEntries), searchable by name, spell or
                   skill — then centers/selects the picked entry's room via
                   MapViewModel.FocusSearchResultByName (see SearchTeacher_OnClick). -->
              <MenuItem Header="Szukaj..."
                        Click="SearchTeacher_OnClick" />
              <Separator />
              <!-- Same commands/toggles as the ⚙ Ustawienia mapy flyout, duplicated here so
                   they're reachable from the right-click menu without opening that flyout. -->
              <MenuItem Header="Wycentruj i śledź"
                        Command="{Binding CenterCommand}" />
              <MenuItem Header="Autowalk po dwukliku"
                        ToggleType="CheckBox"
                        IsChecked="{Binding AutoWalkOnMapDoubleClick, Mode=TwoWay}" />
              <MenuItem Header="Autoscan"
                        ToggleType="CheckBox"
                        IsChecked="{Binding AutoScanOnRoomEnter, Mode=TwoWay}" />
              <MenuItem Header="Zaznacz obszar (prawy przycisk + przeciągnięcie)"
                        ToggleType="CheckBox"
                        IsChecked="{Binding IsDefiningAutoFarmRegion, Mode=TwoWay}" />
              <MenuItem Header="■ STOP"
                        Command="{Binding MainViewModel.StopAutowalkCommand}"
                        IsVisible="{Binding MainViewModel.IsAutowalking}" />
              <Separator />
              <MenuItem Header="{Binding LordGotoMenuHeader}"
                        Command="{Binding LordGotoSelectedRoomCommand}"
                        IsVisible="{Binding LordModeEnabled}" />
              <!-- Local map markers (Phase 1 — not yet shared with other players). This fixed
                   symbol set (see MapViewModel.MarkerLegend, also shown as a legend in the ⚙
                   Ustawienia mapy flyout below) currently cannot be extended with custom symbols. -->
              <MenuItem Header="Dodaj znacznik" IsVisible="{Binding CanEditSelectedRoomMarker}">
                <MenuItem Header="R — Rent"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="R" />
                <MenuItem Header="@ — Oaza"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="@" />
                <MenuItem Header="! — Niebezpieczeństwo"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="!" />
                <MenuItem Header="!! — Wielkie niebezpieczeństwo"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="!!" />
                <MenuItem Header="X — Zamknięte"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="X" />
                <MenuItem Header="# — Przepaść"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="#" />
                <MenuItem Header="T — Nauczyciel"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="T" />
                <MenuItem Header="B — Księga"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="B" />
                <MenuItem Header="+ — Sklep"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="+" />
                <MenuItem Header="Q — Zadanie"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="Q" />
                <MenuItem Header="D — Drzwi"
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="D" />
                <MenuItem Header="? — Inne..."
                          Command="{Binding SetMarkerOnSelectedRoomCommand}" CommandParameter="?" />
                <Separator />
                <!-- Free-text note attached to the selected room, alongside (not instead of) its
                     symbol — shown on hover the same way a teacher's/spellbook mob's info is (see
                     WorldMapControl.UpdateHoverTooltip), and as a small gold corner badge on the
                     map itself (see WorldMapControl.DrawNoteCornerBadge). Needs typed text, so
                     it's a dialog rather than a fixed CommandParameter like the symbols above. -->
                <MenuItem Header="Notatka..."
                          Click="RoomNote_OnClick" />
              </MenuItem>
              <MenuItem Header="Usuń znacznik"
                        Command="{Binding RemoveMarkerFromSelectedRoomCommand}"
                        IsVisible="{Binding SelectedRoomHasMarker}" />
              <!-- Move a misplaced marker (symbol + note both) to the correct room without
                   retyping the note: "Wytnij" removes it from here and holds it, "Wklej" drops it
                   onto whichever room is selected next. Unlike Usuń, Wytnij doesn't discard the
                   marker — see MapViewModel._cutMarker's own doc comment. -->
              <MenuItem Header="Wytnij znacznik"
                        Command="{Binding CutMarkerFromSelectedRoomCommand}"
                        IsVisible="{Binding SelectedRoomHasMarker}" />
              <MenuItem Header="Wklej znacznik"
                        Command="{Binding PasteMarkerOnSelectedRoomCommand}"
                        IsVisible="{Binding HasCutMarker}" />
              <!-- Finds the closest local "R" marker to the player's current room and focuses it
                   the same way "Szukaj pokój" does — double-click on the now-visible room still
                   walks there via the map's existing double-click handling. -->
              <MenuItem Header="Znajdź najbliższy Rent"
                        Command="{Binding FindNearestRentCommand}" />
              <Separator />
              <!-- Same command as the "Zgłoś znaczniki do społeczności" button in the ⚙ Ustawienia
                   mapy flyout — duplicated here so reporting is reachable from the same right-click
                   menu used to add markers in the first place. -->
              <MenuItem Header="Zgłoś znaczniki do społeczności"
                        Command="{Binding ReportMarkersCommand}" />
            </ContextMenu>
          </controls:WorldMapControl.ContextMenu>
        </controls:WorldMapControl>

        <!-- Loading overlay -->
        <Border Background="#CC101010"
                IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20,12"
                CornerRadius="6">
          <TextBlock Text="{Binding StatusMessage}" Foreground="White" />
        </Border>

        <!-- Error overlay -->
        <Border Background="#CC401010"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="16,10"
                CornerRadius="6">
          <StackPanel Spacing="6">
            <SelectableTextBlock Text="{Binding ErrorMessage}"
                                  Foreground="White"
                                  TextWrapping="Wrap"
                                  MaxWidth="480" />
            <Button Content="Spróbuj ponownie"
                    Command="{Binding ReloadCommand}"
                    HorizontalAlignment="Left"
                    Padding="12,6" />
          </StackPanel>
        </Border>

        <!-- The map's own settings — occupies the same top-right corner spot PanelToolView's
             generic per-panel settings button uses for every other panel (hidden for Map there;
             see PanelToolView.axaml.cs), instead of a dedicated "Mapa" header row/button. -->
        <Button x:Name="MapMenuButton"
                Classes="mud-small"
                Content="⚙"
                Padding="6,2"
                Margin="0,4,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Opacity="0.75"
                AutomationProperties.Name="Ustawienia mapy"
                ToolTip.Tip="Ustawienia mapy">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <!-- Flyout content renders outside this panel's own visual tree, so it can't rely
                   on the app's usual "mud-configurable-widget" descendant styling (see
                   Docking.axaml) — the shared widget font is applied explicitly here instead.
                   Scrollable + height-capped: this flyout now also carries everything moved in
                   from the former Autowalk panel (locations, death marks, travel status). -->
              <ScrollViewer MaxHeight="640">
              <StackPanel Spacing="6" MinWidth="230" MaxWidth="300"
                          TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                          TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                          TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
                <TextBlock Classes="mud-heading" Text="Obszar" />
                <ComboBox x:Name="AreaSelector"
                          ItemsSource="{Binding Areas}"
                          SelectedItem="{Binding SelectedArea}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="map:MapArea">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="mud-heading" Text="Poziom" Margin="0,4,0,0" />
                <ComboBox x:Name="ZSelector"
                          ItemsSource="{Binding ZLevels}"
                          SelectedIndex="{Binding SelectedZIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Classes="mud-heading" Text="Tryb mapy" Margin="0,4,0,0" />
                <ComboBox ItemsSource="{Binding DisplayModes}"
                          SelectedItem="{Binding SelectedDisplayMode}"
                          HorizontalAlignment="Stretch" />
                <Border Height="1"
                        Background="{StaticResource MudBrushSlate}"
                        Margin="0,4" />
                <Button Content="Wycentruj i śledź"
                        Command="{Binding CenterCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="10,6" />
                <ToggleSwitch Content="Autowalk po dwukliku"
                              IsChecked="{Binding AutoWalkOnMapDoubleClick}"
                              ToolTip.Tip="Włączone: dwuklik na pokoju od razu rozpoczyna marsz. Wyłączone: dwuklik tylko podpowiada trasę, do potwierdzenia przyciskiem IDŹ DO CELU." />
                <ToggleSwitch Content="Członkowie grupy jako cyfry"
                              IsChecked="{Binding ShowGroupMembersAsNumbers}"
                              ToolTip.Tip="Numery odpowiadają kolejności członków w drużynie." />
                <ToggleSwitch Content="Tryb lorda"
                              IsChecked="{Binding LordModeEnabled}"
                              ToolTip.Tip="Udostępnia polecenie walk w menu prawego przycisku mapy." />
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <TextBlock Classes="mud-heading"
                             Text="Rozmiar przycisków ruchu"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                    <TextBlock Text="{Binding MovementButtonScaleText}" />
                  </Border>
                </Grid>
                <Slider x:Name="MovementButtonScaleSlider"
                        Minimum="{Binding MinMovementButtonScalePercent}"
                        Maximum="{Binding MaxMovementButtonScalePercent}"
                        Value="{Binding MovementButtonScalePercent, Mode=TwoWay}"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        ToolTip.Tip="Zmienia rozmiar wszystkich sześciu przycisków kierunku ruchu." />
                <Border Height="1"
                        Background="{StaticResource MudBrushSlate}"
                        Margin="0,4" />
                <TextBlock Classes="mud-heading" Text="Automatyka po wejściu do pokoju" />
                <ToggleSwitch Content="Autoscan"
                              IsChecked="{Binding AutoScanOnRoomEnter}"
                              ToolTip.Tip="Po każdym wejściu do nowego pokoju (GMCP) klient wysyła „scan”." />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Autokill przeniesiony do Automaty → Farma." />
                <Border Height="1"
                        Background="{StaticResource MudBrushSlate}"
                        Margin="0,4" />
                <TextBlock Classes="mud-heading" Text="Obszary farmy" />
                <TextBlock Classes="mud-faint" TextWrapping="Wrap" Text="{Binding AutoFarmRegionStatusText}" />
                <ItemsControl ItemsSource="{Binding AutoFarmRegionSummaries}"
                              IsVisible="{Binding AutoFarmRegionSummaries.Count}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FarmRegionSummary">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Classes="mud-faint"
                                   Text="{Binding Description}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="✕" Classes="mud-small"
                                Padding="6,1"
                                ToolTip.Tip="Usuń ten obszar"
                                Command="{Binding $parent[ItemsControl].((vm:MapViewModel)DataContext).RemoveAutoFarmRegionCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ToggleSwitch Content="Zaznacz obszar (prawy przycisk + przeciągnięcie)"
                              IsChecked="{Binding IsDefiningAutoFarmRegion}"
                              ToolTip.Tip="Po włączeniu przeciągnij prawym przyciskiem myszy po mapie, aby dodać kolejny prostokątny obszar, po którym farma może się poruszać — można dodać ich kilka, także na różnych obszarach/poziomach mapy." />
                <Button Content="Wyczyść obszary"
                        Classes="mud-small"
                        Command="{Binding ClearAutoFarmRegionCommand}" />
                <StackPanel x:Name="MapEditorPanel" Spacing="6" IsVisible="{Binding LordModeEnabled}">
                  <Border Height="1"
                          Background="{StaticResource MudBrushSlate}"
                          Margin="0,4" />
                  <TextBlock Classes="mud-heading" Text="Edytor mapy" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="NewMapAreaNameBox"
                             Grid.Column="0"
                             Text="{Binding NewMapAreaName, Mode=TwoWay}"
                             PlaceholderText="Nazwa nowego obszaru"
                             ToolTip.Tip="Nowy obszar można utworzyć, gdy mapowanie jest zatrzymane." />
                    <Button x:Name="CreateMapAreaButton"
                            Grid.Column="1"
                            Content="Utwórz obszar"
                            Command="{Binding CreateMapAreaCommand}"
                            Padding="10,6" />
                  </Grid>
                  <ToggleSwitch x:Name="MoveExistingRoomsToNewAreaSwitch"
                                Content="Przenoś istniejące pokoje do wybranego obszaru"
                                IsChecked="{Binding MoveExistingRoomsToNewArea, Mode=TwoWay}"
                                IsEnabled="{Binding CanMoveExistingRoomsToNewArea}"
                                ToolTip.Tip="Zmienia przypisanie napotkanych vnumów na aktualnie wybrany obszar. Pokój, z którego rozpoczęto mapowanie, pozostaje w dotychczasowym obszarze; zmiany można cofnąć." />
                  <WrapPanel>
                    <Button Content="Rozpocznij mapowanie"
                            Command="{Binding StartMapEditorCommand}"
                            IsVisible="{Binding !IsMapEditorActive}"
                            Margin="0,0,6,4"
                            Padding="10,6" />
                    <Button Content="Zatrzymaj mapowanie"
                            Command="{Binding StopMapEditorCommand}"
                            IsVisible="{Binding IsMapEditorActive}"
                            Margin="0,0,6,4"
                            Padding="10,6" />
                  </WrapPanel>
                  <WrapPanel>
                    <Button Content="Zapisz"
                            Command="{Binding SaveMapEditorCommand}"
                            Margin="0,0,6,4"
                            Padding="10,6" />
                    <Button Content="Cofnij"
                            Command="{Binding UndoMapEditorCommand}"
                            Margin="0,0,6,4"
                            Padding="10,6" />
                    <Button Content="Ponów"
                            Command="{Binding RedoMapEditorCommand}"
                            Margin="0,0,6,4"
                            Padding="10,6" />
                  </WrapPanel>
                  <TextBlock Classes="mud-faint"
                             Text="{Binding MapEditorStatus}"
                             MaxWidth="300"
                             TextWrapping="Wrap" />
                  <TextBlock Classes="mud-faint"
                             Text="{Binding MapEditorSourceDescription}"
                             MaxWidth="300"
                             TextWrapping="Wrap" />
                  <TextBlock Classes="mud-faint"
                            Text="Komendy: /map start|stop|save|undo|redo|cancel|info|check|diff|import|export|discard|resolve|step|area|reassign|room|symbol|label|forget|special (cancel anuluje wszystkie niezapisane zmiany; również /mapa i +map)."
                             MaxWidth="300"
                             TextWrapping="Wrap" />
                </StackPanel>

                <!-- Read-only legend for the local map markers (Phase 1 — see "Dodaj znacznik"
                     on the map's right-click menu above). Fixed set, not editable here. -->
                <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />
                <TextBlock Classes="mud-heading" Text="Legenda znaczników" />
                <ItemsControl ItemsSource="{Binding MarkerLegend}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MarkerLegendEntry">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,1">
                        <Border Grid.Column="0" Classes="mud-badge" MinWidth="26" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Symbol}" HorizontalAlignment="Center" FontFamily="Consolas" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="mud-faint" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bulk report: compares local markers against the bundled shared/community
                     dataset by vnum and, if anything is new or different, opens a pre-filled
                     GitHub issue for the maintainer — no per-marker button, no write access
                     needed from the client itself. -->
                <Button Content="Zgłoś znaczniki do społeczności"
                        Command="{Binding ReportMarkersCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="10,6" Margin="0,4,0,0"
                        ToolTip.Tip="Otwiera zgłoszenie na GitHubie z tymi znacznikami, które nie są jeszcze znane społeczności." />

                <!-- ==================================================================
                     Everything below was moved here from the former Autowalk panel —
                     the state and commands still live on MainViewModel (MainWindowViewModel).
                     ================================================================== -->
                <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="mud-heading" Text="Miejsca śmierci" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="mud-badge">
                    <TextBlock Text="{Binding MainViewModel.Deaths.Count}" />
                  </Border>
                </Grid>
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Brak zapisanych zgonów. Ostatnie 10 miejsc śmierci pojawi się tutaj automatycznie."
                           IsVisible="{Binding !MainViewModel.Deaths.Count}" />
                <ItemsControl ItemsSource="{Binding MainViewModel.Deaths}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DeathMarkEntry">
                      <Border Classes="mud-section" Padding="10,8" Margin="0,2">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                          <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Display}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding When}" Classes="mud-faint"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Classes="mud-small"
                                  Content="⚑ IDŹ" Padding="8,2"
                                  ToolTip.Tip="Idź do miejsca śmierci"
                                  Click="GoToDeath_OnClick" />
                          <Button Grid.Column="2"
                                  Classes="mud-small mud-danger"
                                  Content="✕" Padding="6,2"
                                  ToolTip.Tip="Usuń wpis"
                                  Click="DeleteDeath_OnClick" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />
                <TextBlock Classes="mud-heading" Text="Status podróży" />
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Classes="mud-muted" Text="Pozycja:" />
                  <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                             Text="{Binding CurrentRoomName}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Text="{Binding MainViewModel.AutowalkStatusText}"
                           Classes="mud-faint" TextWrapping="Wrap" />
                <Button Content="■ STOP"
                        Classes="mud-danger"
                        Command="{Binding MainViewModel.StopAutowalkCommand}"
                        IsVisible="{Binding MainViewModel.IsAutowalking}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Padding="16,6" />
                <Button Content="⚑ IDŹ"
                        Command="{Binding MainViewModel.GoToSelectedTargetCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Padding="16,6"
                        ToolTip.Tip="Idź do celu wybranego na mapie (tak samo jak komenda /walk)" />
                <StackPanel Spacing="6" IsVisible="{Binding MainViewModel.HasTemporaryTarget}">
                  <TextBlock Text="{Binding MainViewModel.TemporaryTargetDisplay}"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource MudBrushGoldBright}" />
                  <Button Content="⚑ IDŹ DO CELU"
                          Command="{Binding MainViewModel.GoToTemporaryTargetCommand}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" Padding="16,6" />
                </StackPanel>

                <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="mud-heading" Text="Lokacje" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="mud-badge">
                    <TextBlock Text="{Binding MainViewModel.Locations.Count}" />
                  </Border>
                </Grid>
                <Expander Classes="mud-expander" Header="＋ Nowa lokacja" IsExpanded="False">
                  <StackPanel Spacing="8" Margin="0,8,0,0">
                    <TextBox Text="{Binding MainViewModel.NewLocationName}"
                             PlaceholderText="Nazwa lokacji, np. plac-arras…" />
                    <Button Content="⚑ Dodaj obecną pozycję"
                            Command="{Binding MainViewModel.AddCurrentLocationCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="16,6"
                            ToolTip.Tip="Zapisuje pokój, w którym teraz stoisz" />
                    <StackPanel Spacing="2">
                      <TextBlock Classes="mud-faint"
                                 Text="…albo podaj numer pomieszczenia (vnum) innej lokacji:" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding MainViewModel.NewLocationVnum}"
                                 PlaceholderText="np. 12477" />
                        <Button Grid.Column="1" Content="Dodaj"
                                Command="{Binding MainViewModel.AddLocationCommand}" Padding="16,6" />
                      </Grid>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding MainViewModel.NewLocationIsGlobal}"
                              Content="Globalna — wspólna dla wszystkich kont" />
                    <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                               Text="Do członka grupy lub zapisanej lokacji dojdziesz komendą /walk &lt;nazwa&gt;, a do lidera grupy komendą /walk leader. Przycisk IDŹ prowadzi do wybranej lokacji, a /stop przerywa marsz." />
                  </StackPanel>
                </Expander>
                <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                           Text="Brak zapisanych lokacji. Dodaj obecną pozycję albo wpisz vnum docelowego pokoju."
                           IsVisible="{Binding !MainViewModel.Locations.Count}" />
                <Button Classes="mud-small" Content="📁 Nowy folder" Padding="10,4"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Utwórz folder na lokacje"
                        Command="{Binding MainViewModel.CreateFolderCommand}"
                        CommandParameter="{x:Static models:FolderKind.Autowalk}" />
                <controls:FolderTreeView Nodes="{Binding MainViewModel.AutowalkTree}"
                                         SupportsEnableToggle="False"
                                         MoveIntoFolderCommand="{Binding MainViewModel.MoveIntoFolderCommand}"
                                         CreateSubfolderCommand="{Binding MainViewModel.CreateSubfolderCommand}"
                                         RenameFolderCommand="{Binding MainViewModel.RenameFolderCommand}"
                                         DeleteFolderCommand="{Binding MainViewModel.DeleteFolderCommand}"
                                         ToggleFolderGlobalCommand="{Binding MainViewModel.ToggleFolderGlobalCommand}">
                  <controls:FolderTreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:AutowalkLocation">
                      <Border Classes="mud-section" Padding="10,8" Margin="0,2">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                          <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}"
                                         TextTrimming="CharacterEllipsis" />
                              <Border Classes="mud-badge" IsVisible="{Binding IsGlobal}"
                                      ToolTip.Tip="Wspólna dla wszystkich kont">
                                <TextBlock Text="Globalna" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Display}" Classes="mud-faint"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Classes="mud-small"
                                  Content="⚑ IDŹ" Padding="8,2"
                                  ToolTip.Tip="Idź do tej lokacji"
                                  Click="GoToLocation_OnClick" />
                          <Button Grid.Column="2"
                                  Classes="mud-small mud-danger"
                                  Content="✕" Padding="6,2"
                                  ToolTip.Tip="Usuń lokację"
                                  Click="DeleteLocation_OnClick" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </controls:FolderTreeView.ItemTemplate>
                </controls:FolderTreeView>

              </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Panel>
    </Border>

    <!-- ========================================================================
         Selected-room strip: folded in from the former standalone "Pokój" panel — a
         compact bottom bar (image + key details, no room occupants) instead of a
         separate dockable tab, so the info is visible right under the map itself.
         ======================================================================== -->
    <Border Grid.Row="1" Classes="mud-bar-bottom" Padding="8,6"
            IsVisible="{Binding SelectedRoom, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Grid.Column="0"
                Background="{StaticResource MudBrushVoid}"
                BorderBrush="{StaticResource MudBrushGoldDim}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="3"
                Width="64"
                Height="64">
          <Image Source="{Binding SelectedRoomIcon}"
                 Stretch="Uniform"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedRoom.Name}"
                     Classes="mud-heading"
                     TextTrimming="CharacterEllipsis" />
          <WrapPanel>
            <TextBlock Classes="mud-faint" Margin="0,0,14,0"
                       Text="{Binding SelectedRoom.Vnum, StringFormat='Vnum: {0}'}" />
            <TextBlock Classes="mud-faint" Margin="0,0,14,0"
                       Text="{Binding SelectedRoom.Sector, StringFormat='Sektor: {0}'}" />
            <TextBlock Classes="mud-faint" Margin="0,0,14,0"
                       Text="{Binding SelectedRoom.Environment, StringFormat='Środowisko: {0}'}" />
            <TextBlock Classes="mud-faint"
                       Text="{Binding SelectedRoom.Weight, StringFormat='Waga: {0}'}" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Current GMCP exits. The compass shape and all six buttons stay fixed; unavailable
         directions are disabled while available named exits show their destination. -->
    <Border x:Name="MovementSection"
            Grid.Row="2" Classes="mud-bar-bottom" Padding="8,6">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Grid.Column="0"
                   Classes="mud-heading"
                   Text="Ruch"
                   VerticalAlignment="Center" />
        <Grid x:Name="MovementButtonsGrid"
              Grid.Column="1"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,Auto,Auto,16,Auto"
              RowSpacing="4"
              ColumnSpacing="4"
              HorizontalAlignment="Center">
          <Button x:Name="MoveNorthButton"
                  Grid.Row="0" Grid.Column="1"
                  Classes="mud-small movement-button"
                  Width="{Binding MovementButtonWidth}"
                  Height="{Binding MovementButtonHeight}"
                  Command="{Binding MoveThroughExitCommand}"
                  CommandParameter="N"
                  IsEnabled="{Binding NorthExit, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding NorthExitName}">
            <Button.Content>
              <Grid>
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="↑ N" FontWeight="SemiBold" />
                    <TextBlock Text="🔒" IsVisible="{Binding NorthExitIsClosedDoor}" />
                  </StackPanel>
                  <TextBlock Text="{Binding NorthExitName}" MaxWidth="{Binding MovementButtonNameMaxWidth}"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Classes="movement-key"><TextBlock Text="8" /></Border>
              </Grid>
            </Button.Content>
          </Button>
          <Button x:Name="MoveWestButton"
                  Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="mud-small movement-button"
                  Width="{Binding MovementButtonWidth}"
                  Height="{Binding MovementButtonHeight}"
                  Command="{Binding MoveThroughExitCommand}"
                  CommandParameter="W"
                  IsEnabled="{Binding WestExit, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding WestExitName}">
            <Button.Content>
              <Grid>
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="← W" FontWeight="SemiBold" />
                    <TextBlock Text="🔒" IsVisible="{Binding WestExitIsClosedDoor}" />
                  </StackPanel>
                  <TextBlock Text="{Binding WestExitName}" MaxWidth="{Binding MovementButtonNameMaxWidth}"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Classes="movement-key"><TextBlock Text="4" /></Border>
              </Grid>
            </Button.Content>
          </Button>
          <Button x:Name="MoveEastButton"
                  Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                  VerticalAlignment="Center"
                  Classes="mud-small movement-button"
                  Width="{Binding MovementButtonWidth}"
                  Height="{Binding MovementButtonHeight}"
                  Command="{Binding MoveThroughExitCommand}"
                  CommandParameter="E"
                  IsEnabled="{Binding EastExit, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding EastExitName}">
            <Button.Content>
              <Grid>
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="E →" FontWeight="SemiBold" />
                    <TextBlock Text="🔒" IsVisible="{Binding EastExitIsClosedDoor}" />
                  </StackPanel>
                  <TextBlock Text="{Binding EastExitName}" MaxWidth="{Binding MovementButtonNameMaxWidth}"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Classes="movement-key"><TextBlock Text="6" /></Border>
              </Grid>
            </Button.Content>
          </Button>
          <Button x:Name="MoveSouthButton"
                  Grid.Row="1" Grid.Column="1"
                  Classes="mud-small movement-button"
                  Width="{Binding MovementButtonWidth}"
                  Height="{Binding MovementButtonHeight}"
                  Command="{Binding MoveThroughExitCommand}"
                  CommandParameter="S"
                  IsEnabled="{Binding SouthExit, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding SouthExitName}">
            <Button.Content>
              <Grid>
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="↓ S" FontWeight="SemiBold" />
                    <TextBlock Text="🔒" IsVisible="{Binding SouthExitIsClosedDoor}" />
                  </StackPanel>
                  <TextBlock Text="{Binding SouthExitName}" MaxWidth="{Binding MovementButtonNameMaxWidth}"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Classes="movement-key"><TextBlock Text="2" /></Border>
              </Grid>
            </Button.Content>
          </Button>
          <Button x:Name="MoveUpButton"
                  Grid.Row="0" Grid.Column="4"
                  Classes="mud-small movement-button"
                  Width="{Binding MovementButtonWidth}"
                  Height="{Binding MovementButtonHeight}"
                  Command="{Binding MoveThroughExitCommand}"
                  CommandParameter="U"
                  IsEnabled="{Binding UpExit, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding UpExitName}">
            <Button.Content>
              <Grid>
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="↑ U" FontWeight="SemiBold" />
                    <TextBlock Text="🔒" IsVisible="{Binding UpExitIsClosedDoor}" />
                  </StackPanel>
                  <TextBlock Text="{Binding UpExitName}" MaxWidth="{Binding MovementButtonNameMaxWidth}"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Classes="movement-key"><TextBlock Text="9" /></Border>
              </Grid>
            </Button.Content>
          </Button>
          <Button x:Name="MoveDownButton"
                  Grid.Row="1" Grid.Column="4"
                  Classes="mud-small movement-button"
                  Width="{Binding MovementButtonWidth}"
                  Height="{Binding MovementButtonHeight}"
                  Command="{Binding MoveThroughExitCommand}"
                  CommandParameter="D"
                  IsEnabled="{Binding DownExit, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding DownExitName}">
            <Button.Content>
              <Grid>
                <StackPanel Spacing="0" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="↓ D" FontWeight="SemiBold" />
                    <TextBlock Text="🔒" IsVisible="{Binding DownExitIsClosedDoor}" />
                  </StackPanel>
                  <TextBlock Text="{Binding DownExitName}" MaxWidth="{Binding MovementButtonNameMaxWidth}"
                             TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
                <Border Classes="movement-key"><TextBlock Text="3" /></Border>
              </Grid>
            </Button.Content>
          </Button>
        </Grid>
      </Grid>
    </Border>

    <!-- ========================================================================
         Footer bar: status message — Lord mode only (load status + map editor readiness).
         ======================================================================== -->
    <Border Grid.Row="3" Classes="mud-bar-bottom" Padding="10,5"
            IsVisible="{Binding LordModeEnabled}">
      <TextBlock Classes="mud-faint" Text="{Binding LordModeStatusMessage}" />
    </Border>

  </Grid>
</UserControl>
