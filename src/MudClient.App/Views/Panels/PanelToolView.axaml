<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docking="using:MudClient.App.Docking"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:controls="using:MudClient.App.Controls"
             x:Class="MudClient.App.Views.Panels.PanelToolView"
             x:DataType="docking:PanelTool"
             Classes="mud-widget-content">
  <Panel>
    <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

    <!-- The same topic is rendered here, in Terminal overlays and in central Help. Keep this
         button separate from panel settings: help remains available even when a panel has no
         configurable options. -->
    <Button x:Name="HelpButton"
            Classes="mud-small"
            Content="?"
            Padding="6,2"
            Margin="0,4,38,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.85"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            AutomationProperties.Name="Pomoc dla panelu"
            ToolTip.Tip="Pomoc dla tego panelu">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <controls:PanelHelpContent DataContext="{Binding HelpTopic}" />
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- Placeholder for future per-panel settings (no behavior yet — every panel gets one so the
         spot is consistent once real per-panel options land). Hidden for Terminal (no per-panel
         settings make sense there), for Map (whose own settings button already occupies this same
         corner — see MapPanelView), and for Effects (real settings button below). -->
    <Button x:Name="SettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Ustawienia panelu (wkrótce)" />

    <!-- Effects' real settings — shares MainWindowViewModel as Context with most other panels
         (unlike Map's own dedicated ViewModel), so it's special-cased by Id rather than by
         Context's runtime type. -->
    <Button x:Name="EffectsSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Ustawienia efektów">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling (see
               Docking.axaml) — the shared widget font is applied explicitly here instead, and
               inherited by the CheckBox/TextBlock below since neither sets its own. -->
          <StackPanel Spacing="6" MinWidth="230"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <CheckBox Content="Rozszerzony widok efektów"
                      IsChecked="{Binding ((vm:MainWindowViewModel)Context).ShowExtendedEffects}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap" MaxWidth="280"
                       Text="Podstawowy pokazuje nazwę i liczbę, np. „odbicie lustrzane (6)”. Rozszerzony dodaje opis, np. „odbicie lustrzane (6) — Jesteś ukryty pośród swoich odbić.”." />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- Mem's real settings — buff-set management moved in from the former Buffs tool. Shares
         MainWindowViewModel as Context like Effects above, so it's special-cased the same way. -->
    <Button x:Name="MemSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            AutomationProperties.Name="Ustawienia panelu Mem i Buffy"
            ToolTip.Tip="Ustawienia zestawów buffów">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling — the shared widget
               font is applied explicitly here instead. -->
          <StackPanel Spacing="6" MinWidth="240" MaxWidth="300"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <CheckBox Content="Rozszerzony widok innych efektów"
                      IsChecked="{Binding ((vm:MainWindowViewModel)Context).ShowExtendedEffects}" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
              <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).BuffSets}"
                        SelectedItem="{Binding ((vm:MainWindowViewModel)Context).SelectedBuffSet, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="models:BuffSetEntry"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="＋" ToolTip.Tip="Nowy zestaw" Click="CreateBuffSet_OnClick" />
              <Button Grid.Column="2" Content="↻" ToolTip.Tip="Aktualizuj zestaw obecnym stanem" Command="{Binding ((vm:MainWindowViewModel)Context).UpdateBuffSetCommand}" />
              <Button Grid.Column="3" Classes="mud-danger" Content="✕" ToolTip.Tip="Usuń zestaw" IsEnabled="{Binding ((vm:MainWindowViewModel)Context).CanDeleteBuffSet}" Click="DeleteBuffSet_OnClick" />
            </Grid>
            <TextBox Text="{Binding ((vm:MainWindowViewModel)Context).NewBuffSetName, Mode=TwoWay}"
                     PlaceholderText="Nazwa nowego zestawu" KeyDown="NewBuffSetBox_OnKeyDown" />
            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,2" />

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <TextBlock Classes="mud-heading" Text="Dodaj do aktywnego zestawu" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewBuffName, Mode=TwoWay}"
                       PlaceholderText="Nazwa buffa (np. armor)"
                       KeyDown="NewBuffBox_OnKeyDown" />
              <Button Grid.Column="1" Content="Dodaj" Padding="10,6" Click="AddBuff_OnClick" />
            </Grid>

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <TextBlock Classes="mud-heading" Text="Układ buffów" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Liczba buffów w rzędzie:" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).BuffColumnsOptions}"
                      SelectedItem="{Binding ((vm:MainWindowViewModel)Context).BuffColumnsCount, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- Group's real settings — the group spell shortcut editor (label -> spell name, e.g.
         "cc" -> "cure critical") shown as a button next to each group member. Shares
         MainWindowViewModel as Context like Effects/Mem above, so it's special-cased the same way. -->
    <Button x:Name="GroupSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            AutomationProperties.Name="Ustawienia panelu Drużyna"
            ToolTip.Tip="Skróty czarów drużyny">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling — the shared widget
               font is applied explicitly here instead, and inherited by descendants that don't set
               their own. -->
          <StackPanel Spacing="6" MinWidth="260" MaxWidth="320"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
              <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).GroupSpellSets}" SelectedItem="{Binding ((vm:MainWindowViewModel)Context).SelectedGroupSpellSet, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="models:GroupSpellSetEntry"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="＋" ToolTip.Tip="Nowy zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).CreateGroupSpellSetCommand}" />
              <Button Grid.Column="2" Content="↻" ToolTip.Tip="Aktualizuj zestaw obecnym stanem" Command="{Binding ((vm:MainWindowViewModel)Context).UpdateGroupSpellSetCommand}" />
              <Button Grid.Column="3" Classes="mud-danger" Content="✕" ToolTip.Tip="Usuń zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).DeleteGroupSpellSetCommand}" />
            </Grid>
            <TextBox PlaceholderText="Nazwa nowego zestawu" Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellSetName, Mode=TwoWay}" />
            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,2" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Zdefiniuj skrót (np. „cc”) dla nazwy czaru/umiejętności (np. „cure critical”) — obok każdego członka drużyny pojawi się przycisk, który rzuci go na tę konkretną osobę." />
            <ItemsControl ItemsSource="{Binding ((vm:MainWindowViewModel)Context).GroupSpells}"
                          Tag="{Binding ((vm:MainWindowViewModel)Context)}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:GroupSpellShortcut">
                  <Border Classes="mud-status-chip" Padding="6,3" Margin="0,0,4,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="→" />
                      <TextBlock Text="{Binding SpellName}" Opacity="0.75" />
                      <Button Classes="mud-small mud-danger"
                              Content="✕"
                              Padding="4,0"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)Tag).RemoveGroupSpellCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="60,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBox Grid.Row="0" Grid.Column="0"
                       PlaceholderText="cc"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellLabel, Mode=TwoWay}" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       PlaceholderText="cure critical"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellName, Mode=TwoWay}" />
              <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="+ Dodaj"
                      HorizontalAlignment="Stretch"
                      Command="{Binding ((vm:MainWindowViewModel)Context).AddGroupSpellCommand}" />
            </Grid>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- OffensiveActions' real settings — the offensive-action (spell/skill) and custom-command
         shortcut editors, matching the panel's two sections. Shares MainWindowViewModel as
         Context like Effects/Mem/Group above, so it's special-cased the same way. -->
    <Button x:Name="OffensiveSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            AutomationProperties.Name="Ustawienia panelu Offensywne i Definiowalne"
            ToolTip.Tip="Skróty akcji offensywnych i komend">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling — the shared widget
               font is applied explicitly here instead, and inherited by descendants that don't set
               their own. -->
          <StackPanel Spacing="6" MinWidth="260" MaxWidth="320"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
              <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).ActionSets}" SelectedItem="{Binding ((vm:MainWindowViewModel)Context).SelectedActionSet, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="models:ActionSetEntry"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="＋" ToolTip.Tip="Nowy zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).CreateActionSetCommand}" />
              <Button Grid.Column="2" Content="↻" ToolTip.Tip="Aktualizuj zestaw obecnym stanem" Command="{Binding ((vm:MainWindowViewModel)Context).UpdateActionSetCommand}" />
              <Button Grid.Column="3" Classes="mud-danger" Content="✕" ToolTip.Tip="Usuń zestaw" Command="{Binding ((vm:MainWindowViewModel)Context).DeleteActionSetCommand}" />
            </Grid>
            <TextBox PlaceholderText="Nazwa nowego zestawu" Text="{Binding ((vm:MainWindowViewModel)Context).NewActionSetName, Mode=TwoWay}" />
            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,2" />
            <ToggleSwitch Content="Sekcje jedna przy drugiej"
                          IsChecked="{Binding ((vm:MainWindowViewModel)Context).OffensiveSectionsSideBySide, Mode=TwoWay}"
                          ToolTip.Tip="Offensywne po lewej, Definiowalne po prawej — lepiej widoczne na szerokim oknie." />

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <TextBlock Classes="mud-heading" Text="Offensywne" />
            <ItemsControl ItemsSource="{Binding ((vm:MainWindowViewModel)Context).OffensiveActions}"
                          Tag="{Binding ((vm:MainWindowViewModel)Context)}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:OffensiveActionShortcut">
                  <Border Classes="mud-status-chip" Padding="6,3" Margin="0,0,4,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="→" />
                      <TextBlock Text="{Binding SpellName}" Opacity="0.75" />
                      <Button Classes="mud-small mud-danger"
                              Content="✕"
                              Padding="4,0"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)Tag).RemoveOffensiveActionCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBox Grid.Row="0"
                       PlaceholderText="Nazwa spella/skilla (pełna)"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewOffensiveActionSpellName, Mode=TwoWay}" />
              <TextBox Grid.Row="1"
                       PlaceholderText="Skrót"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewOffensiveActionLabel, Mode=TwoWay}" />
              <Button Grid.Row="2"
                      Content="Dodaj"
                      HorizontalAlignment="Stretch"
                      Padding="10,6"
                      Command="{Binding ((vm:MainWindowViewModel)Context).AddOffensiveActionCommand}" />
            </Grid>
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Liczba przycisków w rzędzie:" Margin="0,4,0,0" />
            <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).OffensiveColumnsOptions}"
                      SelectedItem="{Binding ((vm:MainWindowViewModel)Context).OffensiveActionColumnsCount, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <TextBlock Classes="mud-heading" Text="Definiowalne" />
            <ItemsControl ItemsSource="{Binding ((vm:MainWindowViewModel)Context).CustomCommands}"
                          Tag="{Binding ((vm:MainWindowViewModel)Context)}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CustomCommandShortcut">
                  <Border Classes="mud-status-chip" Padding="6,3" Margin="0,0,4,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="→" />
                      <TextBlock Text="{Binding Command}" Opacity="0.75" />
                      <Button Classes="mud-small mud-danger"
                              Content="✕"
                              Padding="4,0"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)Tag).RemoveCustomCommandCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBox Grid.Row="0"
                       PlaceholderText="Podaj pełną komendę"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewCustomCommandCommand, Mode=TwoWay}" />
              <TextBox Grid.Row="1"
                       PlaceholderText="Skrót"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewCustomCommandLabel, Mode=TwoWay}" />
              <Button Grid.Row="2"
                      Content="Dodaj"
                      HorizontalAlignment="Stretch"
                      Padding="10,6"
                      Command="{Binding ((vm:MainWindowViewModel)Context).AddCustomCommandCommand}" />
            </Grid>
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Liczba przycisków w rzędzie:" Margin="0,4,0,0" />
            <ComboBox ItemsSource="{Binding ((vm:MainWindowViewModel)Context).OffensiveColumnsOptions}"
                      SelectedItem="{Binding ((vm:MainWindowViewModel)Context).CustomCommandColumnsCount, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- Chat's real settings — sound-on-new-message toggle. Shares MainWindowViewModel as
         Context like Effects/Mem/Group above, so it's special-cased the same way. -->
    <Button x:Name="ChatSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Ustawienia czatu">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling — the shared widget
               font is applied explicitly here instead. -->
          <StackPanel Spacing="6" MinWidth="230" MaxWidth="280"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <CheckBox Content="Dźwięk przy nowej wiadomości"
                      IsChecked="{Binding ((vm:MainWindowViewModel)Context).ChatSoundOnNewMessageEnabled}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Krótki dźwięk systemowy przy każdej nowej linii komunikacji (say/tell/clantell/grouptell/yell/shout)." />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

    <Button x:Name="StatisticsSettingsButton"
            Classes="mud-small" Content="⚙" Padding="6,2" Margin="0,4,4,0"
            HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Ustawienia statystyk">
      <Button.Flyout><Flyout Placement="BottomEdgeAlignedRight">
        <StackPanel Spacing="6" MinWidth="230"
                    TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                    TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                    TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
          <Button Content="Resetuj statystyki postaci" Classes="mud-danger"
                  HorizontalAlignment="Stretch" Click="ResetStatistics_OnClick"/>
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Usuwa całą zapisaną historię aktywnej postaci."/>
        </StackPanel>
      </Flyout></Button.Flyout>
    </Button>
  </Panel>
</UserControl>
