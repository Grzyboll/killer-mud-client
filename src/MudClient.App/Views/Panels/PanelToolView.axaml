<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docking="using:MudClient.App.Docking"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             x:Class="MudClient.App.Views.Panels.PanelToolView"
             x:DataType="docking:PanelTool"
             Classes="mud-widget-content">
  <Panel>
    <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

    <!-- Placeholder for future per-panel settings (no behavior yet — every panel gets one so the
         spot is consistent once real per-panel options land). Hidden for Terminal (no per-panel
         settings make sense there), for Map (whose own settings button already occupies this same
         corner — see MapPanelView), and for Mem/Group/Chat (real settings button below). -->
    <Button x:Name="SettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Ustawienia panelu (wkrótce)" />

    <!-- Mem's real settings — buff-set management moved in from the former Buffs tool, plus the
         former standalone Effects tool's "rozszerzony widok efektów" toggle and the "pokaż mem"
         toggle, now that Effects/Kondycja/Mem/Buffy are one merged panel. Shares
         MainWindowViewModel as Context with most other panels (unlike Map's own dedicated
         ViewModel), so it's special-cased by Id rather than by Context's runtime type. -->
    <Button x:Name="MemSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Ustawienia Mem / Buffy / Efektów">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling — the shared widget
               font is applied explicitly here instead. -->
          <ScrollViewer MaxHeight="520">
          <StackPanel Spacing="6" MinWidth="240" MaxWidth="300"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <CheckBox Content="Pokaż mem"
                      IsChecked="{Binding ((vm:MainWindowViewModel)Context).ShowMemSpellSlots}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap" MaxWidth="280"
                       Text="Wyłącz, by schować listę zapamiętanych zaklęć wg kręgu i zostawić tylko Kondycję i Buffy." />

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <CheckBox Content="Rozszerzony widok efektów"
                      IsChecked="{Binding ((vm:MainWindowViewModel)Context).ShowExtendedEffects}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap" MaxWidth="280"
                       Text="Podstawowy pokazuje nazwę i liczbę, np. „odbicie lustrzane (6)”. Rozszerzony dodaje opis, np. „odbicie lustrzane (6) — Jesteś ukryty pośród swoich odbić.”." />

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <TextBlock Classes="mud-heading" Text="Nowy zestaw buffów" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewBuffSetName, Mode=TwoWay}"
                       PlaceholderText="Nazwa zestawu"
                       KeyDown="NewBuffSetBox_OnKeyDown" />
              <Button Grid.Column="1" Content="Utwórz" Padding="10,6" Click="CreateBuffSet_OnClick" />
            </Grid>

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <TextBlock Classes="mud-heading" Text="Aktywny zestaw" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0"
                       Text="{Binding ((vm:MainWindowViewModel)Context).BuffSetNameDraft, Mode=TwoWay}"
                       PlaceholderText="Nazwa zestawu"
                       KeyDown="BuffSetNameBox_OnKeyDown" />
              <Button Grid.Column="1" Content="Zmień nazwę" Padding="10,6" Click="RenameBuffSet_OnClick" />
            </Grid>
            <Button Content="Usuń zestaw"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding ((vm:MainWindowViewModel)Context).CanDeleteBuffSet}"
                    Click="DeleteBuffSet_OnClick" />
            <TextBlock Classes="mud-faint"
                       Text="Ostatniego zestawu nie można usunąć."
                       IsVisible="{Binding !((vm:MainWindowViewModel)Context).CanDeleteBuffSet}" />

            <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

            <TextBlock Classes="mud-heading" Text="Dodaj do aktywnego zestawu" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewBuffName, Mode=TwoWay}"
                       PlaceholderText="Nazwa buffa (np. armor)"
                       KeyDown="NewBuffBox_OnKeyDown" />
              <Button Grid.Column="1" Content="Dodaj" Padding="10,6" Click="AddBuff_OnClick" />
            </Grid>
          </StackPanel>
          </ScrollViewer>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- Group's real settings — the group spell shortcut editor (label -> spell name, e.g.
         "cc" -> "cure critical") shown as a button next to each group member. Shares
         MainWindowViewModel as Context like Mem above, so it's special-cased the same way. -->
    <Button x:Name="GroupSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Skróty czarów drużyny">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling — the shared widget
               font is applied explicitly here instead, and inherited by descendants that don't set
               their own. -->
          <StackPanel Spacing="6" MinWidth="260" MaxWidth="320"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Zdefiniuj skrót (np. „cc”) dla nazwy czaru/umiejętności (np. „cure critical”) — obok każdego członka drużyny pojawi się przycisk, który rzuci go na tę konkretną osobę." />
            <ItemsControl ItemsSource="{Binding ((vm:MainWindowViewModel)Context).GroupSpells}"
                          Tag="{Binding ((vm:MainWindowViewModel)Context)}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:GroupSpellShortcut">
                  <Border Classes="mud-status-chip" Padding="6,3" Margin="0,0,4,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="→" />
                      <TextBlock Text="{Binding SpellName}" Opacity="0.75" />
                      <Button Classes="mud-small mud-danger"
                              Content="✕"
                              Padding="4,0"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)Tag).RemoveGroupSpellCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="60,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBox Grid.Row="0" Grid.Column="0"
                       PlaceholderText="cc"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellLabel, Mode=TwoWay}" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       PlaceholderText="cure critical"
                       Text="{Binding ((vm:MainWindowViewModel)Context).NewGroupSpellName, Mode=TwoWay}" />
              <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="+ Dodaj"
                      HorizontalAlignment="Stretch"
                      Command="{Binding ((vm:MainWindowViewModel)Context).AddGroupSpellCommand}" />
            </Grid>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- Chat's real settings — sound-on-new-message toggle. Shares MainWindowViewModel as
         Context like Mem/Group above, so it's special-cased the same way. -->
    <Button x:Name="ChatSettingsButton"
            Classes="mud-small"
            Content="⚙"
            Padding="6,2"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0.75"
            FontFamily="{DynamicResource WidgetFontFamilyResource}"
            FontSize="{DynamicResource WidgetFontSizeResource}"
            FontWeight="{DynamicResource WidgetFontWeightResource}"
            ToolTip.Tip="Ustawienia czatu">
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight">
          <!-- Flyout content renders outside PanelToolView's own visual tree, so it can't rely
               on the app's usual "mud-configurable-widget" descendant styling — the shared widget
               font is applied explicitly here instead. -->
          <StackPanel Spacing="6" MinWidth="230" MaxWidth="280"
                      TextElement.FontFamily="{DynamicResource WidgetFontFamilyResource}"
                      TextElement.FontSize="{DynamicResource WidgetFontSizeResource}"
                      TextElement.FontWeight="{DynamicResource WidgetFontWeightResource}">
            <CheckBox Content="Dźwięk przy nowej wiadomości"
                      IsChecked="{Binding ((vm:MainWindowViewModel)Context).ChatSoundOnNewMessageEnabled}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Krótki dźwięk systemowy przy każdej nowej linii komunikacji (say/tell/clantell/grouptell/yell/shout)." />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Panel>
</UserControl>
