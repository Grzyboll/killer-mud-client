<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:services="using:MudClient.App.Services"
             x:Class="MudClient.App.Views.Panels.SettingsPanelView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8" Margin="12">

      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Wspólne dla wszystkich kont. Zapisywane automatycznie." />

      <TextBlock Classes="mud-heading" Text="Tekst z MUD-a" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Czcionka" />
            <ComboBox ItemsSource="{Binding AvailableFonts}"
                      SelectedItem="{Binding OutputFontFamily}"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}"
                             FontFamily="{Binding Converter={x:Static services:AppFontFamilyConverter.Instance}}"
                             FontSize="13" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <CheckBox Content="Zawijaj długie linie w oknie terminala"
                    IsChecked="{Binding OutputWordWrap}" />

          <CheckBox Content="Pokazuj paski HP i MV po bokach terminala"
                    IsChecked="{Binding ShowTerminalVitalsBars}" />

          <StackPanel Spacing="3">
            <CheckBox Content="Pokaż obrażenia liczbowo"
                      IsChecked="{Binding ShowNumericDamageEnabled}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Dopisuje przybliżoną liczbę obrażeń pod liniami typu „Ranisz golema mieczem.” — tylko dla ciosów zadanych przez Ciebie." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox Content="Pokaż klasę losowych ksiąg magicznych"
                      IsChecked="{Binding AnnotateRandomBookClassEnabled}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Dopisuje klasę po nazwie losowej księgi (random 'spellbook'), np. „duża księga triumfu (Paladyn)”." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox Content="Pokaż nauczycieli przy umiejętnościach"
                      IsChecked="{Binding AnnotateSkillTrainersEnabled}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Dopisuje po każdej umiejętności w wyniku komendy „skill”, kto może Cię jeszcze w niej szkolić, np. „axe  10  3 + 0 (Mistrz Moran)” — na podstawie znanych nauczycieli z Killeropedii i Twojego aktualnego poziomu." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox Content="Pokaż źródło brakujących zaklęć"
                      IsChecked="{Binding AnnotateSpellSourcesEnabled}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Dopisuje po każdym brakującym zaklęciu w wyniku komendy „spell” (puste nawiasy „(  )”), jaki znany moby uczy z niego, np. „(  )[1] shield (Rogaty demon)” — na podstawie znanych mobów-nauczycieli zaklęć z Killeropedii." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox Content="Pokaż liczby przy score"
                      IsChecked="{Binding AnnotateScoreEnabled}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Dopisuje przybliżony zakres liczbowy po każdej cesze w wyniku komendy „score”, np. „Twoja sila jest srednia. (116-129)”." />
          </StackPanel>

          <CheckBox Content="Pogrubiona"
                    IsChecked="{Binding OutputFontBold}" />

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Schemat kolorów Telnet/ANSI" />
            <ComboBox ItemsSource="{Binding AvailableTelnetColorSchemes}"
                      SelectedItem="{Binding TelnetColorScheme}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Zmienia standardowe 16 kolorów. Kolory RGB wysłane przez MUD pozostają bez zmian." />
          </StackPanel>

          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Rozmiar" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding OutputFontSizeText}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinOutputFontSize}"
                    Maximum="{Binding MaxOutputFontSize}"
                    Value="{Binding OutputFontSize}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True" />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Podgląd" />
            <Border Classes="mud-inset" Padding="10,8">
              <TextBlock Text="Strażnik miasta wchodzi z północy.&#x0a;&gt; zabij straznika"
                         FontFamily="{Binding OutputFontFamilyValue}"
                         FontSize="{Binding OutputFontSize}"
                         FontWeight="{Binding OutputFontWeight}"
                         Foreground="{StaticResource MudBrushParchment}"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <Button Content="Przywróć domyślne"
                  Command="{Binding ResetOutputFontCommand}"
                  Classes="mud-small"
                  HorizontalAlignment="Right" />

          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Ile linijek pamięta terminal" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding TerminalMaxLinesText}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinTerminalMaxLines}"
                    Maximum="{Binding MaxTerminalMaxLines}"
                    Value="{Binding TerminalMaxLines}"
                    TickFrequency="1000"
                    IsSnapToTickEnabled="True" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Ile ostatnich linijek terminal trzyma w pamięci, zanim najstarsze zaczną znikać z góry przy przewijaniu. Zmiana czyści bieżącą zawartość terminala." />
          </StackPanel>

        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Widgety" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Wspólna czcionka wszystkich paneli poza terminalem." />
          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Czcionka" />
            <ComboBox ItemsSource="{Binding AvailableFonts}"
                      SelectedItem="{Binding WidgetFontFamily}"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}"
                             FontFamily="{Binding Converter={x:Static services:AppFontFamilyConverter.Instance}}"
                             FontSize="13" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="mud-label" Text="Rozmiar" />
              <Border Grid.Column="1" Classes="mud-badge mud-badge-gold">
                <TextBlock Text="{Binding WidgetFontSizeText}" />
              </Border>
            </Grid>
            <Slider Minimum="{Binding MinWidgetFontSize}"
                    Maximum="{Binding MaxWidgetFontSize}"
                    Value="{Binding WidgetFontSize}"
                    TickFrequency="1" IsSnapToTickEnabled="True" />
          </StackPanel>
          <CheckBox Content="Pogrubiona"
                    IsChecked="{Binding WidgetFontBold}" />
          <Border Classes="mud-inset" Padding="10,8">
            <TextBlock Text="Podgląd tekstu w widżetach"
                       FontFamily="{Binding WidgetFontFamilyValue}"
                       FontSize="{Binding WidgetFontSize}"
                       FontWeight="{Binding WidgetFontWeight}" />
          </Border>
          <Button Content="Przywróć domyślne"
                  Command="{Binding ResetWidgetFontCommand}"
                  Classes="mud-small" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Nakładki na terminal" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Wspólna przezroczystość wszystkich paneli przypiętych jako nakładka na terminal." />
          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Przezroczystość" />
            <Slider Minimum="{Binding MinTerminalOverlayOpacity}"
                    Maximum="{Binding MaxTerminalOverlayOpacity}"
                    Value="{Binding TerminalOverlayOpacity}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Komendy" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">

          <CheckBox Content="Czyść pole komendy po wysłaniu"
                    IsChecked="{Binding ClearCommandInputAfterSend}" />

          <StackPanel Spacing="3">
            <TextBlock Classes="mud-label" Text="Separator składania komend" />
            <TextBox Text="{Binding CommandStackingSeparator}"
                     MaxLength="10"
                     Width="100"
                     HorizontalAlignment="Left" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Globalny separator dla komend wpisywanych, aliasów, triggerów i timerów. Pusta wartość wyłącza składanie (tylko nowe linie). Zapisywane automatycznie." />
          </StackPanel>

        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Nagrywanie sesji" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Zapisuje wszystko, co pojawia się w terminalu — tekst z MUD-a i wysyłane komendy — do zwykłego pliku tekstowego (bez kolorów ANSI), w podkatalogu „Records” katalogu ustawień. Nie jest wznawiane po ponownym uruchomieniu klienta — trzeba włączyć je od nowa." />
          <TextBlock Text="{Binding SessionRecordingStatusText}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Otwórz folder"
                    Command="{Binding OpenSessionRecordingFolderCommand}"
                    Classes="mud-small" />
            <Button Content="{Binding SessionRecordingButtonText}"
                    Command="{Binding ToggleSessionRecordingCommand}"
                    Classes="mud-small" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Aplikacja" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Klient sprawdza przy starcie, czy na stronie forka jest nowsza wersja. Aktualizacja aplikacji nie instaluje się sama — trzeba ją pobrać i uruchomić ręcznie." />
          <TextBlock Text="{Binding AppUpdateStatus}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Sprawdź aktualizacje aplikacji"
                    Command="{Binding CheckAppUpdatesCommand}"
                    Classes="mud-small" />
            <Button Content="Pobierz nową wersję"
                    Command="{Binding OpenAppUpdateCommand}"
                    Classes="mud-small"
                    IsVisible="{Binding IsAppUpdateAvailable}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Dane gry" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Mapa i cała Killeropedia mogą być aktualizowane bez pobierania nowego pliku aplikacji. Pobrane dane są przechowywane w katalogu ustawień." />
          <TextBlock Text="{Binding ContentUpdateStatus}"
                     TextWrapping="Wrap" />
          <TextBlock Classes="mud-faint"
                     Text="{Binding ContentUpdateDescription}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding IsContentUpdateAvailable}" />
          <ProgressBar IsIndeterminate="True"
                       Height="4"
                       IsVisible="{Binding IsContentUpdateBusy}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Sprawdź aktualizacje"
                    Command="{Binding CheckContentUpdatesCommand}"
                    Classes="mud-small" />
            <Button Content="Aktualizuj wszystko"
                    Command="{Binding InstallContentUpdateCommand}"
                    Classes="mud-small"
                    IsVisible="{Binding IsContentUpdateAvailable}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="mud-heading" Text="Kopia ustawień" Margin="0,6,0,0" />
      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                     Text="Eksport obejmuje cały katalog danych aplikacji: ustawienia, konta i profile, automatyzację, zapisany układ oraz pozostałe dane." />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ExportSettingsButton"
                    Content="Eksportuj do ZIP"
                    Classes="mud-small"
                    Click="ExportSettings_OnClick" />
            <Button x:Name="ImportSettingsButton"
                    Content="Importuj z ZIP"
                    Classes="mud-small"
                    Click="ImportSettings_OnClick" />
          </StackPanel>
          <TextBlock x:Name="SettingsTransferStatusText"
                     Classes="mud-faint"
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
