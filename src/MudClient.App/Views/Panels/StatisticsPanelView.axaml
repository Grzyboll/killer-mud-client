<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.StatisticsPanelView"
             x:DataType="vm:MainWindowViewModel">
  <TabControl Classes="mud-subtabs">
    <TabItem Header="Sesja">
      <ScrollViewer><StackPanel Margin="10" Spacing="8">
        <Border Classes="mud-section"><Grid Margin="10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Text="Czas sesji"/><TextBlock Grid.Column="1" Text="{Binding Statistics.SessionDurationText}"/>
          <TextBlock Grid.Row="1" Text="EXP netto"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.NetExperience, StringFormat={}{0:N0}}"/>
          <TextBlock Grid.Row="2" Text="EXP/h"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.ExperiencePerHour, StringFormat={}{0:N0}}"/>
          <TextBlock Grid.Row="3" Text="EXP za zabicia"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.KillExperience, StringFormat={}{0:N0}}"/>
          <TextBlock Grid.Row="4" Text="Ucieczki / śmierci"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Statistics.FleeAndDeathCountText}"/>
          <TextBlock Grid.Row="5" Text="Utracony EXP: ucieczki / śmierci"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Statistics.FleeAndDeathLossText}"/>
          <TextBlock Grid.Row="6" Text="Zabicia / średnia nagroda"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Statistics.KillsAndAverageText}"/>
          <TextBlock Grid.Row="7" Text="Obrażenia: własne / grupa"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Statistics.OwnAndGroupDamageText}"/>
        </Grid></Border>
        <Border Classes="mud-section"><StackPanel Margin="10" Spacing="3">
          <TextBlock Text="Ostatnie zabicie" Classes="mud-faint"/><TextBlock Text="{Binding Statistics.LastEnemy}"/>
          <TextBlock Text="{Binding Statistics.LastKillExperience, StringFormat=EXP: {0:N0}}"/>
          <TextBlock Text="{Binding Statistics.RemainingToLevel, StringFormat=Do awansu: {0:N0}}"/>
          <TextBlock Text="{Binding Statistics.LastKillProgressPercent, StringFormat=Postęp z zabicia: {0:F2}%}"/>
          <TextBlock Text="{Binding Statistics.EstimatedTimeToLevel, StringFormat=Szacowany czas: {0}}"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Moby">
      <ScrollViewer><ItemsControl Margin="8" ItemsSource="{Binding Statistics.Mobs}"><ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MobExperienceSummary"><Border Classes="mud-section" Margin="0,2" Padding="8">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Trend}"/>
            <TextBlock Grid.Row="1" Classes="mud-faint" Text="{Binding Kills, StringFormat=Zabicia: {0}}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mud-faint" Text="{Binding Average, StringFormat=Śr. nagroda: {0:N0} EXP}"/>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="mud-faint" Text="{Binding AverageTotalExperience, StringFormat=Śr. łączny EXP na pokonanie: {0:N0}}"/>
            <TextBlock Grid.Row="3" Classes="mud-faint" Text="{Binding LastKilledAt, StringFormat=Ostatnio: {0:g}}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="mud-faint" Text="{Binding LastTotalExperience, StringFormat=EXP: {0:N0}}"/>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Classes="mud-faint" Text="{Binding AverageGroupCombatDamage, StringFormat=Śr. przybliżone HP: ~{0:N0}}"/>
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="3" Height="30" Margin="0,4,0,0">
              <ItemsControl ItemsSource="{Binding TrendPoints}"><ItemsControl.ItemsPanel><ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="3"/>
              </ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MobTrendPoint"><Border Width="7" Height="{Binding Height}"
                    VerticalAlignment="Bottom" Background="{StaticResource MudBrushGold}"
                    ToolTip.Tip="{Binding Value, StringFormat={}{0:N0} EXP}"/></DataTemplate>
              </ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Grid>
        </Border></DataTemplate>
      </ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </TabItem>
    <TabItem Header="Bilans HP">
      <TabControl Classes="mud-subtabs">
        <TabItem Header="Sesja">
          <ScrollViewer><StackPanel Margin="10" Spacing="8">
            <Border Classes="mud-section" Padding="10"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="HP stracone"/><TextBlock Grid.Column="1" Text="{Binding Statistics.SessionHealthLost, StringFormat={}{0:N0}}"/>
              <TextBlock Grid.Row="1" Text="HP uleczone"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.SessionHealthRestored, StringFormat={}{0:N0}}"/>
              <TextBlock Grid.Row="2" Text="HP udzielone innym (szac.)"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.SessionHealingGiven, StringFormat=~{0:N0}}"/>
              <TextBlock Grid.Row="3" Text="Bilans własnego HP"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.SessionHealthBalanceText}"/>
              <TextBlock Grid.Row="4" Text="Największa utrata HP"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Statistics.SessionLargestHealthLoss, StringFormat={}{0:N0}}"/>
              <TextBlock Grid.Row="5" Text="Największe leczenie"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Statistics.SessionLargestHealing, StringFormat={}{0:N0}}"/>
            </Grid></Border>
            <ItemsControl ItemsSource="{Binding Statistics.SessionHealthBreakdown}"><ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HealthBreakdownRow"><Border Classes="mud-section" Margin="0,2" Padding="8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Category}"/><TextBlock Grid.Column="1" Text="{Binding AmountText}"/>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="mud-faint" Text="{Binding Details}" TextWrapping="Wrap"/>
                </Grid>
              </Border></DataTemplate>
            </ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Ostatnia walka">
          <ScrollViewer><StackPanel Margin="10" Spacing="8">
            <Border Classes="mud-section" Padding="10"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="HP stracone"/><TextBlock Grid.Column="1" Text="{Binding Statistics.LastCombatHealthLost, StringFormat={}{0:N0}}"/>
              <TextBlock Grid.Row="1" Text="HP uleczone"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.LastCombatHealthRestored, StringFormat={}{0:N0}}"/>
              <TextBlock Grid.Row="2" Text="HP udzielone innym (szac.)"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.LastCombatHealingGiven, StringFormat=~{0:N0}}"/>
              <TextBlock Grid.Row="3" Text="Bilans własnego HP"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.LastCombatHealthBalanceText}"/>
              <TextBlock Grid.Row="4" Text="Największa utrata HP"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Statistics.LastCombatLargestHealthLoss, StringFormat={}{0:N0}}"/>
              <TextBlock Grid.Row="5" Text="Największe leczenie"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Statistics.LastCombatLargestHealing, StringFormat={}{0:N0}}"/>
            </Grid></Border>
            <ItemsControl ItemsSource="{Binding Statistics.LastCombatHealthBreakdown}"><ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HealthBreakdownRow"><Border Classes="mud-section" Margin="0,2" Padding="8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Category}"/><TextBlock Grid.Column="1" Text="{Binding AmountText}"/>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="mud-faint" Text="{Binding Details}" TextWrapping="Wrap"/>
                </Grid>
              </Border></DataTemplate>
            </ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
    </TabItem>
    <TabItem Header="Historia">
      <Grid RowDefinitions="*,Auto"><ScrollViewer><ItemsControl Margin="8" ItemsSource="{Binding Statistics.History}"><ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SessionExperienceSummary"><Border Classes="mud-section" Margin="0,2" Padding="8"><StackPanel>
          <TextBlock Text="{Binding StartedAt, StringFormat=Od: {0:g}}"/><TextBlock Text="{Binding EndedAt, StringFormat=Do: {0:g}}"/>
          <TextBlock Classes="mud-faint" Text="{Binding DurationText, StringFormat=Czas: {0}}"/>
          <TextBlock Classes="mud-faint" Text="{Binding Experience, StringFormat=EXP netto: {0:N0}}"/>
          <TextBlock Classes="mud-faint" Text="{Binding Kills, StringFormat=Zabicia: {0}}"/>
          <TextBlock Classes="mud-faint" Text="{Binding MostKilled, StringFormat=Najczęściej: {0}}"/>
        </StackPanel></Border></DataTemplate>
      </ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <Border Grid.Row="1" Classes="mud-section" Margin="8" Padding="8"><StackPanel>
        <TextBlock Text="Suma wszystkich zapisanych sesji"/>
        <TextBlock Classes="mud-faint" Text="{Binding Statistics.TotalRecordedDurationText, StringFormat=Czas: {0}}"/>
        <TextBlock Classes="mud-faint" Text="{Binding Statistics.TotalRecordedExperience, StringFormat=EXP netto: {0:N0}}"/>
        <TextBlock Classes="mud-faint" Text="{Binding Statistics.TotalKills, StringFormat=Zabicia: {0:N0}}"/>
      </StackPanel></Border></Grid>
    </TabItem>
    <TabItem Header="Buffy">
      <ScrollViewer>
        <ItemsControl Margin="8" ItemsSource="{Binding BuffStatistics}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BuffStatisticsSummary">
              <Border Classes="mud-section" Margin="0,2" Padding="8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Remaining}"/>
                  <TextBlock Grid.Row="1" Classes="mud-faint" Text="{Binding Estimate, StringFormat=Estymowany czas: {0}}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="mud-faint" Text="{Binding Confidence, StringFormat=Pewność: {0}}"/>
                  <TextBlock Grid.Row="2" Classes="mud-faint" Text="{Binding SessionUses, StringFormat=Użycia w sesji: {0}}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Classes="mud-faint" Text="{Binding HistoryUses, StringFormat=Użycia w historii: {0}}"/>
                  <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="mud-faint" Text="{Binding SampleCount, StringFormat=Poprawne pomiary: {0}}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Rekordy"><ScrollViewer><StackPanel Margin="12" Spacing="8">
      <TextBlock Text="{Binding Statistics.BestExperiencePerHour, StringFormat=Najlepszy EXP/h: {0:N0}}"/>
      <TextBlock Text="{Binding Statistics.LargestKillDetails, StringFormat=Największa nagroda: {0}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Statistics.StrongestHitDetails, StringFormat=Najmocniejszy cios: {0}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Statistics.LongestSessionDetails, StringFormat=Najdłuższa sesja: {0}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Statistics.BestSessionDetails, StringFormat=Najlepsza sesja: {0}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Statistics.MostKilledOverall, StringFormat=Najczęściej pokonywany: {0}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Statistics.TotalKills, StringFormat=Łącznie zabitych: {0}}"/>
    </StackPanel></ScrollViewer></TabItem>
  </TabControl>
</UserControl>
