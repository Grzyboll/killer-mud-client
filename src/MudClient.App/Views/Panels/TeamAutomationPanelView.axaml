<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.TeamAutomationPanelView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8" Margin="10,8,10,12">
      <TextBlock Classes="mud-heading" Text="Automaty drużynowe" />
      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Automatyczne reakcje na stan drużyny i komunikaty z gry." />

      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutoAssistEnabled}"
                      Content="Autoassist — automatyczne wspieranie drużyny" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy GMCP wykryje, że inny członek drużyny walczy w tym samym pokoju, klient wyśle poniższą komendę. Jeśli przestaniesz walczyć, a członek drużyny nadal walczy, komenda zostanie ponowiona." />
            <TextBlock Margin="0,6,0,0"
                       Text="Komenda rozpoczynająca walkę" />
            <TextBox Text="{Binding AutoAssistCommandTemplate, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="as" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Domyślnie „as” (goły assist — gra sama dobiera przeciwnika). Możesz wpisać dowolną inną komendę, np. „charge {cel}”, „backstab {cel}” albo „kick {cel}” — „{cel}” zostanie zastąpione nazwą przeciwnika, z którym walczy członek drużyny. Bez „{cel}” komenda jest wysyłana dosłownie, tak jak dotąd „as”." />
            <TextBlock Margin="0,6,0,0"
                       Text="Komendy po asyście" />
            <TextBox MinHeight="64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Np. wesprzyj;czar 'ochrona'"
                     Text="{Binding AutoAssistFollowUpCommands, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Wysyłane po komendzie „as”. Możesz wpisać wiele wierszy lub rozdzielić komendy separatorem ustawionym w opcjach klienta." />
            <TextBlock Margin="0,6,0,0"
                       Text="Moby wykluczone z autoassista" />
            <TextBox MinHeight="64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Dokładna nazwa moba — po jednej w wierszu"
                     Text="{Binding AutoAssistExcludedMobNamesText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Klient nie zareaguje, gdy członek grupy w aktualnym pokoju walczy z mobem o jednej z tych nazw. Dopasowanie obejmuje całą nazwę i nie rozróżnia wielkości liter." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutoAssistNpcEnabled}"
                      Content="Autoassist NPC — rozkaż własnemu summonowi wspierać w walce" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy Twoja pozycja GMCP zmieni się na „walczy”, klient wyśle „order &lt;NPC&gt; assist” do każdego NPC w aktualnej grupie (np. przywołanego/zaczarowanego summona). Nie wymaga bycia liderem grupy." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding GroupOrdersEnabled}"
                      Content="Ordery — wykonuj rozkazy członków drużyny" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Klient wykona komendę z komunikatu „Gracz rozkazuje ci 'komenda'.” tylko wtedy, gdy Gracz znajduje się w aktualnej grupie GMCP." />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding RemoteControlEnabled}"
                      Content="Zdalne sterowanie — wykonuj polecenia z „!” od drugiej postaci" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy MUD blokuje komendę „order” komunikatem „Nie jesteś przywódcą tej grupy.”, to obejście: podana postać mówi (say) coś zaczynającego się od „!”, np. „!stand”, a klient wykonuje to jako komendę — bez potrzeby bycia liderem po żadnej ze stron. Zwykłe wypowiedzi tej postaci (bez „!”) zostają zwykłym czatem." />
            <TextBlock Margin="0,6,0,0"
                       Text="Postać, której polecenia wykonywać" />
            <TextBox Text="{Binding RemoteControlCharacterName, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Np. Gandalf" />
          </StackPanel>

          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutoRecastOnLeaderSnapEnabled}"
                      Content="Autorecast — reaguj na pstryknięcie palcami lidera" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy lider aktualnej grupy GMCP pstryknie palcami, klient wyśle poniższe komendy." />
            <TextBlock Margin="0,6,0,0"
                       Text="Komendy po pstryknięciu" />
            <TextBox MinHeight="64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Np. /recast"
                     Text="{Binding AutoRecastOnLeaderSnapCommandsText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Możesz wpisać wiele wierszy lub rozdzielić komendy separatorem ustawionym w opcjach klienta." />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
