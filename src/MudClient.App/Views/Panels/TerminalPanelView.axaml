<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MudClient.App.Controls"
             xmlns:models="using:MudClient.App.Models"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.TerminalPanelView"
             x:DataType="vm:MainWindowViewModel">
  <Panel>
  <Grid RowDefinitions="*,Auto,Auto" ColumnDefinitions="Auto,*,Auto">

    <!-- HP vertical indicator (left) – spans full panel height -->
    <Border x:Name="HitPointsBar"
            Grid.Column="0" Grid.RowSpan="3"
            Width="46"
            IsVisible="{Binding ShowTerminalVitalsBars}"
            Padding="2,8" Margin="2,0,0,0"
            Background="{StaticResource MudBrushStone}" CornerRadius="3">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="3">
        <TextBlock Grid.Row="0" Text="HP" FontSize="9" FontWeight="Bold"
                   Foreground="{StaticResource MudBrushCrimsonBright}"
                   HorizontalAlignment="Center" />
        <ProgressBar Grid.Row="1" Orientation="Vertical"
                     Minimum="0"
                     Maximum="{Binding Vitals.MaxHitPoints}"
                     Value="{Binding Vitals.HitPoints}"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Center" Width="14"
                     Foreground="{StaticResource MudBrushCrimson}"
                     Background="{StaticResource MudBrushVoid}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Vitals.HitPoints}" FontSize="9"
                     Foreground="{StaticResource MudBrushParchment}" />
          <TextBlock Text="/" FontSize="9"
                     Foreground="{StaticResource MudBrushParchmentFaint}" />
          <TextBlock Text="{Binding Vitals.MaxHitPoints}" FontSize="8"
                     Foreground="{StaticResource MudBrushParchmentFaint}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- MUD output (center) -->
    <Grid Grid.Column="1" Grid.Row="0">
      <controls:MudOutputView x:Name="MudOutput"
                              OutputFontFamily="{Binding OutputFontFamilyValue}"
                              OutputFontSize="{Binding OutputFontSize}"
                              OutputFontWeight="{Binding OutputFontWeight}"
                              TelnetColorScheme="{Binding TelnetColorScheme}"
                              WordWrap="{Binding OutputWordWrap}" />

      <!-- Scoped to the output row specifically (not the whole Panel below) so neither overlay
           column can ever grow tall enough to reach behind the timer strip or command bar — see
           TerminalOverlayHost.axaml.cs; a column's height fraction is only a fraction of whatever
           bounds it's given, and a stack with enough cards can outgrow that fraction's MinHeight
           floor, which is what let the right (edge) column spill past the left one before. -->
      <controls:TerminalOverlayHost x:Name="OverlayHost" />
    </Grid>

    <!-- Active timers — a compact strip just above the command bar instead of floating over the
         top-right of the output, where pinned overlay columns used to cover it (see
         TerminalOverlayHost). Every timer stays visible here regardless of enabled state, so
         pausing one with ⏸ leaves its row in place (with ▶ to resume) instead of making it
         disappear until you go find it again in the Automaty panel. -->
    <StackPanel Grid.Column="1" Grid.Row="1">
      <!-- Timers + skills on cooldown (left) share this bar with the live in-game hour & sky
           (right), which stays pinned to the right edge regardless of how many timers/skills
           are shown to its left. -->
      <Border Classes="mud-bar-bottom" Padding="8,3">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
            <StackPanel IsVisible="{Binding ShowTimersOnStatusBarEnabled}">
            <ItemsControl ItemsSource="{Binding Timers}" IsVisible="{Binding Timers.Count}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:TimerEntry">
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,12,0"
                              ToolTip.Tip="{Binding Name}">
                    <Button Content="⏸" FontSize="9" Padding="3,1" MinWidth="0" MinHeight="0"
                            Classes="mud-small"
                            IsVisible="{Binding IsEnabled}"
                            ToolTip.Tip="Wstrzymaj timer"
                            Command="{Binding $parent[UserControl].DataContext.ToggleTimerCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="▶" FontSize="9" Padding="3,1" MinWidth="0" MinHeight="0"
                            Classes="mud-small"
                            IsVisible="{Binding !IsEnabled}"
                            ToolTip.Tip="Wznów timer"
                            Command="{Binding $parent[UserControl].DataContext.ToggleTimerCommand}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding ShortName}" FontSize="9" VerticalAlignment="Center"
                               Foreground="{StaticResource MudBrushParchmentDim}" />
                    <TextBlock Text="{Binding RemainingText}" FontSize="9" VerticalAlignment="Center"
                               IsVisible="{Binding IsEnabled}"
                               FontFamily="Consolas"
                               Foreground="{StaticResource MudBrushGoldBright}" />
                    <TextBlock Text="wstrzymany" FontSize="9" VerticalAlignment="Center"
                               IsVisible="{Binding !IsEnabled}"
                               Classes="mud-faint" />
                    <Button Content="⟳" FontSize="9" Padding="3,1" MinWidth="0" MinHeight="0"
                            Classes="mud-small"
                            IsVisible="{Binding IsEnabled}"
                            ToolTip.Tip="Zresetuj odliczanie"
                            Command="{Binding $parent[UserControl].DataContext.RestartTimerCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- Skills currently on cooldown (Char.Skills.Timeout GMCP), shown as "* skillname"
                 for as long as the skill's timeout stays true. -->
            <ItemsControl ItemsSource="{Binding SkillsOnCooldown}" IsVisible="{Binding SkillsOnCooldown.Count}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding StringFormat='* {0}'}" FontSize="9" VerticalAlignment="Center"
                             Margin="0,0,12,0"
                             FontFamily="Consolas"
                             Foreground="{StaticResource MudBrushCrimsonBright}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Triggers, laid out the same way as timers above (pause/resume + name) — every
                 trigger stays visible regardless of enabled state, same reasoning as timers. The
                 name is dim gray at rest and flashes blue for a few seconds right after its
                 pattern matches a line (see AutomationRuleEntry.RecentlyFired /
                 MainWindowViewModel.FlashTriggerRecentlyFired). -->
            <StackPanel IsVisible="{Binding ShowTriggersOnStatusBarEnabled}">
            <ItemsControl ItemsSource="{Binding TriggerRules}" IsVisible="{Binding TriggerRules.Count}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:AutomationRuleEntry">
                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,12,0"
                              ToolTip.Tip="{Binding PatternAndActionSummary}">
                    <Button Content="⏸" FontSize="9" Padding="3,1" MinWidth="0" MinHeight="0"
                            Classes="mud-small"
                            IsVisible="{Binding IsEnabled}"
                            ToolTip.Tip="Wstrzymaj trigger"
                            Command="{Binding $parent[UserControl].DataContext.ToggleRuleCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="▶" FontSize="9" Padding="3,1" MinWidth="0" MinHeight="0"
                            Classes="mud-small"
                            IsVisible="{Binding !IsEnabled}"
                            ToolTip.Tip="Wznów trigger"
                            Command="{Binding $parent[UserControl].DataContext.ToggleRuleCommand}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding Name}" FontSize="9" VerticalAlignment="Center"
                               FontFamily="Consolas"
                               Classes="mud-trigger-name"
                               Classes.mud-recently-fired="{Binding RecentlyFired}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- A Trigger match or Timer firing lights this up for a few seconds — see
                 MainWindowViewModel.ShowAutomationActivity/RecentAutomationActivityText. -->
            <TextBlock Text="{Binding RecentAutomationActivityText}"
                       FontSize="9" VerticalAlignment="Center"
                       IsVisible="{Binding RecentAutomationActivityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{StaticResource MudBrushArcaneBlueBright}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="🕐" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Text="{Binding WorldTime.TimeName}" FontSize="9" VerticalAlignment="Center"
                         FontFamily="Consolas"
                         Foreground="{StaticResource MudBrushGoldBright}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="☁" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Text="{Binding WorldTime.Sky}" FontSize="9" VerticalAlignment="Center"
                         Foreground="{StaticResource MudBrushParchmentDim}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Command bar. Uses its full width always — overlay columns float on top of the Terminal
         without reserving any space from it (see TerminalOverlayHost), so there is no need to
         make room for them here. -->
    <Border Grid.Column="1" Grid.Row="2" Classes="mud-bar-bottom" Padding="8,6">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 x:Name="CommandBox"
                 Classes="terminal-input"
                 Text="{Binding CommandText}"
                 PlaceholderText="Wpisz komendę (Enter or Shift+Enter)"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 TextWrapping="Wrap"
                 MaxHeight="120"
                 KeyDown="CommandBox_OnKeyDown" />

        <!-- "/" command autocomplete — shown while CommandBox holds a bare "/" plus an
             in-progress command name (see MainWindowViewModel.RefreshCommandSuggestions).
             IsLightDismissEnabled="False" because visibility is entirely driven by CommandText
             (via HasCommandSuggestions), not by focus/outside-click — Escape/typing past the
             command name close it instead, see CommandBox_OnPreviewKeyDown. -->
        <Popup x:Name="CommandSuggestionsPopup"
               IsOpen="{Binding HasCommandSuggestions}"
               PlacementTarget="{Binding #CommandBox}"
               Placement="Top"
               IsLightDismissEnabled="False"
               Focusable="False">
          <Border Classes="mud-section" Padding="2" MinWidth="220" MaxHeight="240" CornerRadius="4">
            <ScrollViewer>
              <ListBox x:Name="CommandSuggestionsList"
                       ItemsSource="{Binding CommandSuggestions}"
                       SelectedIndex="{Binding SelectedCommandSuggestionIndex, Mode=TwoWay}"
                       SelectionMode="Single"
                       Tapped="CommandSuggestionsList_OnTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='/{0}'}"
                               FontFamily="Consolas"
                               Padding="6,3" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
        </Popup>

        <TextBox Grid.Column="1"
                 x:Name="SearchBox"
                 Width="190"
                 MinHeight="30"
                 PlaceholderText="Wyszukaj..."
                 ToolTip.Tip="Szukaj w terminalu (Enter/▲: starsze, Shift+Enter/▼: nowsze)"
                 TextChanged="SearchBox_OnTextChanged"
                 KeyDown="SearchBox_OnKeyDown" />
        <Button Grid.Column="2"
                x:Name="SearchPrevButton"
                Classes="mud-small"
                Content="▲"
                MinWidth="0"
                Padding="8,7"
                ToolTip.Tip="Poprzednie dopasowanie (starsze)"
                Click="SearchPrevButton_OnClick" />
        <Button Grid.Column="3"
                x:Name="SearchNextButton"
                Classes="mud-small"
                Content="▼"
                MinWidth="0"
                Padding="8,7"
                ToolTip.Tip="Następne dopasowanie (nowsze)"
                Click="SearchNextButton_OnClick" />
        <Button Grid.Column="4"
                Content="➤"
                Padding="20,7"
                ToolTip.Tip="Wyślij"
                Command="{Binding SendCommandCommand}"
                Click="SendButton_OnClick" />
      </Grid>
    </Border>

    <!-- MV vertical indicator (right) – spans full panel height -->
    <Border x:Name="MovementPointsBar"
            Grid.Column="2" Grid.RowSpan="3"
            Width="46"
            IsVisible="{Binding ShowTerminalVitalsBars}"
            Padding="2,8" Margin="0,0,2,0"
            Background="{StaticResource MudBrushStone}" CornerRadius="3">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="3">
        <TextBlock Grid.Row="0" Text="MV" FontSize="9" FontWeight="Bold"
                   Foreground="{StaticResource MudBrushEmeraldBright}"
                   HorizontalAlignment="Center" />
        <ProgressBar Grid.Row="1" Orientation="Vertical"
                     Minimum="0"
                     Maximum="{Binding Vitals.MaxEndurancePoints}"
                     Value="{Binding Vitals.EndurancePoints}"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Center" Width="14"
                     Foreground="{StaticResource MudBrushEmerald}"
                     Background="{StaticResource MudBrushVoid}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Vitals.EndurancePoints}" FontSize="9"
                     Foreground="{StaticResource MudBrushParchment}" />
          <TextBlock Text="/" FontSize="9"
                     Foreground="{StaticResource MudBrushParchmentFaint}" />
          <TextBlock Text="{Binding Vitals.MaxEndurancePoints}" FontSize="8"
                     Foreground="{StaticResource MudBrushParchmentFaint}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
  </Panel>
</UserControl>
